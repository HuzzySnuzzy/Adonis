<%- include('/partials/head') %>
<main class="auth-card">
  <div class="auth-logo"><%- include('/partials/logo', { big: true }) %></div>
  <p class="muted center">Log in om verder te gaan.</p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Gebruikersnaam
      <input name="username" value="<%= username %>" autocomplete="username" autocapitalize="none" required autofocus>
    </label>
    <label>Wachtwoord
      <input name="password" type="password" autocomplete="current-password" required>
    </label>
    <label class="check remember"><input type="checkbox" name="remember" value="1" checked> Ingelogd blijven op dit apparaat</label>
    <button class="btn btn-primary btn-block" type="submit">Inloggen</button>
  </form>
  <%# Met welke server is dit apparaat verbonden? Vervaagd tot je erop wijst of tikt (niet zomaar meelezen). %>
  <div class="server-url">
    <span class="muted">Server</span>
    <span class="server-addr" tabindex="0" title="Aanwijzen of aantikken om het adres te zien" data-server-url><%= serverUrl %></span>
    <% if (inApp && appCanChangeServer) { %><a href="adonis-app:server-wijzigen" class="server-change" title="Een ander serveradres kiezen (sneltoets Ctrl + ,)">Wijzigen</a>
    <% } else if (inApp) { %><span class="muted small">Wijzigen: druk op <kbd>Ctrl</kbd> + <kbd>,</kbd></span><% } %>
  </div>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
