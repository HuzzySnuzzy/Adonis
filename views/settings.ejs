<%- include('/partials/head') %>
<%
  const p = user.prefs;
  const THEMES = [
    { value: 'adonis', label: 'ADONIS', help: 'Het thema der thema\'s: wit marmer met gouden aders, bladgoud, Egeïsch blauw en een Griekse sleutelrand' },
    { value: 'system', label: 'Systeem', help: 'Volgt de instelling van je apparaat' },
    { value: 'light', label: 'Licht', help: 'Altijd licht' },
    { value: 'dark', label: 'Donker', help: 'Altijd donker, prettig in een donkere werkplaats' },
    { value: 'oled', label: 'OLED', help: 'Puur zwart: alles lijkt in de lucht te zweven' },
    { value: 'vcds', label: 'VCDS', help: 'Klassiek diagnosevenster: grijs, 3D-knoppen en een blauwe titelbalk' },
    { value: 'neon', label: 'Neon', help: 'Futuristisch: neon, hologrammen en animaties' },
    { value: 'ice', label: 'Black Ice', help: 'ICE·XVIII: zwart kristalrooster, ionensporen en rijp' },
  ];
  const STARTS = [
    { value: '/start', label: 'Startscherm (grote knoppen)' },
    { value: '/', label: 'Klanten' },
    { value: '/werkopdrachten', label: 'Werkopdrachten' },
    { value: '/werkopdracht/nieuw', label: 'Nieuwe werkopdracht' },
    { value: '/bandenhotel', label: 'Bandenhotel' },
    { value: '/voorraad', label: 'Voorraad' },
    { value: '/portaal', label: 'Portaal (websites)' },
    { value: '/importeren', label: 'Importeren' },
  ];
%>
<main class="page settings-page">
  <h1>Instellingen</h1>
  <p class="muted">Ingelogd als <strong><%= user.username %></strong> (<%= user.name %>)<%= user.is_admin ? ' · beheerder' : '' %>.
    Deze instellingen gelden alleen voor jou, op elk apparaat waarop je inlogt.</p>

  <section class="card app-download" id="app">
    <h2>ADONIS-app voor Windows</h2>
    <% if (inApp) { %>
    <p class="app-in-use">✔ Je gebruikt de ADONIS-app<%= inAppVersion ? ' (versie ' + inAppVersion + ')' : '' %>. Met <b>Ctrl + ,</b> wijzig je het adres van de server.</p>
    <% if (appOutdated && appSelfUpdates) { %><p class="muted small">Versie <%= appInfo.version %> wordt op de achtergrond gedownload en gebruikt bij de volgende start van de app.</p>
    <% } else if (appOutdated) { %><p class="fx-why">Er is een nieuwere ADONIS-app (versie <%= appInfo.version %>). <a href="<%= appDownload %>">Download ADONIS-app.exe</a>,
      sluit de app en vervang het oude bestand door het nieuwe. Het serveradres en je instellingen blijven bewaard.
      <b>Dit hoeft maar één keer:</b> vanaf deze versie werkt de app zichzelf bij.</p><% } %>
    <p class="muted small">Op een andere pc installeren? <a href="<%= appDownload %>">Download ADONIS-app.exe</a> · <a href="/instellingen/adonis-app.json">adonis-app.json</a></p>
  </section>
    <% } else { %>
    <p class="muted small">Een eigen venster voor ADONIS, met eigen icoon in de taakbalk: geen tabbladen of adresbalk, dus ADONIS
      raakt niet meer kwijt tussen de tabbladen van de browser. Geen installatie nodig.</p>
    <ol class="sys-steps">
      <li>Download <strong>ADONIS-app.exe</strong> en zet hem in een eigen map (bijv. op het bureaublad of in <code>C:\ADONIS</code>).</li>
      <li>Start hem. De eerste keer vraagt de app het adres van de server: <code><%= serverUrl %></code></li>
      <li>Meerdere pc's tegelijk instellen? Zet het bestand <strong>adonis-app.json</strong> naast de .exe; dan vraagt de app niets.</li>
    </ol>
    <div class="settings-actions app-actions">
      <a class="btn btn-primary" href="<%= appDownload %>">ADONIS-app.exe downloaden</a>
      <a class="btn" href="/instellingen/adonis-app.json">adonis-app.json (met dit adres)</a>
    </div>
    <p class="muted small">In de app: <b>Ctrl + ,</b> wijzigt het adres, <b>Ctrl + R</b> herlaadt, <b>F11</b> = volledig scherm.
      Windows kan bij de eerste keer waarschuwen dat de app onbekend is: klik op <em>Meer informatie → Toch uitvoeren</em>.</p>
  </section>
    <% } %>


  <form method="post" action="/instellingen" class="settings-form" data-guard>
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <section class="card simple-card">
      <h2>Eenvoudige weergave</h2>
      <label class="check big-check">
        <input type="hidden" name="simple" value="off">
        <input type="checkbox" name="simple" value="on" <%= p.simple === 'on' ? 'checked' : '' %>>
        <span><b>Eenvoudige weergave aan</b><br><span class="muted small">Grotere letters en knoppen, een startscherm met grote knoppen,
          alleen het belangrijkste in het menu. Fijn als u niet zo vaak met computers werkt.</span></span>
      </label>
      <% if (p.simple === 'on' && user.is_admin) { %>
      <p class="muted small">Beheer (staat in deze weergave niet in het menu):
        <a href="/importeren">Importeren</a> · <a href="/gebruikers">Gebruikers</a><% if (user.is_owner) { %> · <a href="/systeem">Systeem</a><% } %></p>
      <% } %>
    </section>

    <section class="card" id="autofoto">
      <h2>Voorbeeldfoto's</h2>
      <label class="check big-check">
        <input type="hidden" name="carimg" value="off">
        <input type="checkbox" name="carimg" value="on" <%= p.carimg !== 'off' ? 'checked' : '' %>>
        <span><b>Foto van het automodel tonen op de klantpagina</b><br><span class="muted small">Een voorbeeldfoto van het model
          (bijvoorbeeld een Nissan Note), zodat u de auto snel herkent. Gratis, van Wikipedia: alleen merk en model worden opgezocht,
          nooit het kenteken of de klant. Het kan een andere uitvoering of kleur zijn.</span></span>
      </label>
      <label class="check big-check">
        <input type="hidden" name="partimg" value="off">
        <input type="checkbox" name="partimg" value="on" <%= p.partimg !== 'off' ? 'checked' : '' %>>
        <span><b>Voorbeeldfoto van onderdelen tonen in de voorraad</b><br><span class="muted small">Een voorbeeld van de soort onderdeel
          (bijvoorbeeld een bougie of oliefilter), ook van Wikipedia. Eigen foto's van een onderdeel gaan altijd voor.</span></span>
      </label>
    </section>

    <section class="card">
      <h2>Thema</h2>
      <div class="choice-grid themes" role="radiogroup" aria-label="Thema">
        <% for (const t of THEMES) { const secret = SECRET_THEMES.includes(t.value); %>
        <label class="choice<%= secret ? ' secret-theme' : '' %>" <%= secret ? 'data-secret-theme' : '' %> <%= secret && p.secret !== 'on' ? 'hidden' : '' %>>
          <input type="radio" name="theme" value="<%= t.value %>" <%= p.theme === t.value ? 'checked' : '' %>>
          <span class="choice-body">
            <span class="theme-preview theme-preview-<%= t.value %>" aria-hidden="true">
              <span class="tp-bar"></span><span class="tp-card"><span></span><span></span><span></span></span>
            </span>
            <span class="choice-label"><%= t.label %><% if (secret) { %> <span class="secret-tag" title="Geheim thema">geheim</span><% } %></span>
            <span class="choice-help"><%= t.help %></span>
          </span>
        </label>
        <% } %>
      </div>
      <label class="check secret-toggle">
        <input type="hidden" name="secret" value="off">
        <input type="checkbox" name="secret" value="on" data-secret-toggle <%= p.secret === 'on' ? 'checked' : '' %>>
        <span><b>Geheime thema's</b> <span class="muted small">– toont ook Neon en Black Ice (met veel animaties)</span></span>
      </label>
      <p class="muted small">Tip: met de themaknop naast “Nieuwe werkopdracht” in de menubalk kies je snel een thema.</p>
    </section>

    <section class="card">
      <h2>Effecten</h2>
      <p class="muted small">Hoeveel beweging je ziet: de opstartanimatie bij elk thema, en de bewegende achtergronden van de geheime thema's. Staat je apparaat op “minder beweging”, dan staat alles altijd stil.</p>
      <div class="choice-grid two" role="radiogroup" aria-label="Effecten">
        <label class="choice">
          <input type="radio" name="fx" value="full" <%= (p.fx || 'full') === 'full' ? 'checked' : '' %>>
          <span class="choice-body"><span class="choice-label">Volledig</span><span class="choice-help">Opstartanimatie en alle bewegende effecten</span></span>
        </label>
        <label class="choice">
          <input type="radio" name="fx" value="calm" <%= p.fx === 'calm' ? 'checked' : '' %>>
          <span class="choice-body"><span class="choice-label">Rustig</span><span class="choice-help">Geen opstartanimatie, veel minder beweging (fijn op oudere computers)</span></span>
        </label>
      </div>
      <%# Waarom er (nu) geen animaties zijn, zodat dat geen raadsel is. %>
      <p class="fx-why" data-fx-reduced hidden>Let op: <b>dit apparaat vraagt om minder beweging</b>, daarom speelt ADONIS geen animaties af.
        Op Windows zet je ze weer aan via <i>Instellingen → Toegankelijkheid → Visuele effecten → Animatie-effecten</i>.</p>
      <p class="fx-replay"><button type="button" class="btn btn-small" data-replay-boot>Opstartanimatie nu bekijken</button>
        <span class="muted small">De opstartanimatie speelt na het inloggen en één keer per venster (of bij het starten van de ADONIS-app), niet bij elke pagina.</span></p>
    </section>

    <% if (!inApp) { %>
    <section class="card mscale-card">
      <h2>Weergave op telefoon</h2>
      <p class="muted small">Hoe groot ADONIS op een telefoon of tablet wordt getoond. Kleiner = meer op het scherm.
        Je ziet het meteen. (Deze instelling staat alleen op telefoons en tablets.)</p>
      <div class="choice-grid mscale-grid" role="radiogroup" aria-label="Weergave op telefoon">
        <% for (const [v, label] of [['100', 'Groot'], ['90', 'Normaal'], ['80', 'Compact'], ['70', 'Klein'], ['60', 'Heel klein']]) { %>
        <label class="choice">
          <input type="radio" name="mscale" value="<%= v %>" <%= (p.mscale || '90') === v ? 'checked' : '' %> data-mscale-choice>
          <span class="choice-body"><span class="mscale-sample mscale-<%= v %>" aria-hidden="true">Aa</span><span class="choice-label"><%= label %></span><span class="choice-help"><%= v %>%</span></span>
        </label>
        <% } %>
      </div>
    </section>
    <% } %>

    <section class="card">
      <h2>Werkopdrachtformulier</h2>
      <p class="muted small">Hoe ingevulde tekst op het formulier wordt weergegeven. Afdrukken gebeurt altijd op wit papier.</p>
      <div class="choice-grid two" role="radiogroup" aria-label="Letters in het formulier">
        <label class="choice">
          <input type="radio" name="ink" value="hand" <%= p.ink === 'hand' ? 'checked' : '' %>>
          <span class="choice-body">
            <span class="ink-preview ink-hand">Accu vervangen – 121665 km</span>
            <span class="choice-label">Handschrift</span>
            <span class="choice-help">Lijkt op het papieren formulier</span>
          </span>
        </label>
        <label class="choice">
          <input type="radio" name="ink" value="plain" <%= p.ink === 'plain' ? 'checked' : '' %>>
          <span class="choice-body">
            <span class="ink-preview ink-plain">Accu vervangen – 121665 km</span>
            <span class="choice-label">Gewone letters</span>
            <span class="choice-help">Zo goed mogelijk leesbaar</span>
          </span>
        </label>
      </div>
    </section>

    <section class="card">
      <h2>Startpagina</h2>
      <label>Na het inloggen openen
        <select name="start">
          <% for (const s of STARTS) { %><option value="<%= s.value %>" <%= p.start === s.value ? 'selected' : '' %>><%= s.label %></option><% } %>
        </select>
      </label>
    </section>

    <div class="settings-actions">
      <button class="btn btn-primary" type="submit">Instellingen opslaan</button>
    </div>
  </form>

  <section class="card">
    <h2>Wachtwoord wijzigen</h2>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="post" action="/instellingen/wachtwoord" class="stack narrow-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Huidig wachtwoord <input type="password" name="current" autocomplete="current-password" required></label>
      <label>Nieuw wachtwoord (minimaal 8 tekens) <input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
      <label>Herhaal nieuw wachtwoord <input type="password" name="password2" autocomplete="new-password" minlength="8" required></label>
      <button class="btn" type="submit">Wachtwoord wijzigen</button>
    </form>
  </section>

  <section class="card changelog" id="nieuw">
    <h2>Wat is er nieuw</h2>
    <p class="muted small">U gebruikt ADONIS <b>v<%= appInfo.version %></b>. Hieronder alle versies, de nieuwste eerst.</p>
    <% const nlDay = (iso) => new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso + 'T00:00:00Z')); %>
    <% changelog.forEach((v, i) => { const current = v.version === appInfo.version; %>
    <details class="cl-version<%= current ? ' is-current' : '' %>"<%= i < 3 ? ' open' : '' %>>
      <summary>
        <span class="cl-ver">v<%= v.version %></span>
        <span class="cl-title"><%= v.title %></span>
        <% if (current) { %><span class="cl-badge">deze versie</span><% } %>
        <span class="cl-date muted small"><%= nlDay(v.date) %></span>
      </summary>
      <ul><% for (const item of v.items) { %><li><%= item %></li><% } %></ul>
    </details>
    <% }) %>
  </section>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
