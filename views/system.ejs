<%- include('/partials/head') %>
<%
  const st = tunnelState;
  const on = cf && cf.enabled;
  const STATUS = {
    'uit': ['Uit', 'off'], 'downloaden': ['Bezig met downloaden…', 'busy'], 'starten': ['Verbinden…', 'busy'],
    'verbonden': ['Online', 'ok'], 'verbinding verbroken': ['Verbinding verbroken – opnieuw verbinden…', 'busy'], 'fout': ['Fout', 'bad'],
  };
  const [label, cls] = STATUS[st.status] || [st.status, 'off'];
%>
<main class="page system-page">
  <h1>Systeem</h1>
  <p class="muted">Alleen zichtbaar voor de ADONIS-beheerder.</p>

  <%
    const c = bk.c;
    const mb = (n) => (n / 1024 / 1024).toFixed(1).replace('.', ',') + ' MB';
    const when = (iso) => iso ? new Intl.DateTimeFormat('nl-NL', { timeZone: process.env.APP_TIMEZONE || 'Europe/Amsterdam', weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(iso)) : '';
    const fileWhen = (name) => { const m = /(\d{4})-(\d{2})-(\d{2})_(\d{2})(\d{2})/.exec(name); return m ? `${m[3]}-${m[2]}-${m[1]} ${m[4]}:${m[5]}` : name; };
    const HEALTH = { ok: ['In orde', 'ok'], mislukt: ['Laatste backup mislukt', 'bad'], 'te-oud': ['Laatste backup is te oud', 'busy'], nooit: ['Nog geen backup', 'busy'] };
    const [hLabel, hCls] = HEALTH[bk.health];
  %>
  <section class="card" id="onderdelen">
    <h2>Onderdelen</h2>
    <p class="muted small">Zet uit wat u niet gebruikt, bijvoorbeeld alleen het bandenhotel of alleen de voorraad. Een onderdeel dat uit staat
      verdwijnt voor iedereen uit het menu, het startscherm en het bureaublad, en de pagina's ervan zijn niet meer te openen.
      Er wordt niets verwijderd: zet u het weer aan, dan is alles terug. Klanten staan altijd aan.</p>
    <form method="post" action="/systeem/onderdelen" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="notify-grid">
      <% for (const f of FEATURES) { %>
        <label class="check big-check">
          <input type="checkbox" name="f_<%= f.key %>" value="on" <%= feat[f.key] ? 'checked' : '' %>>
          <span><b><%= f.name %></b><br><span class="muted small"><%= f.help %></span></span>
        </label>
      <% } %>
      </div>
      <p><button class="btn btn-primary" type="submit">Onderdelen opslaan</button></p>
    </form>
  </section>

  <section class="card autofill-card" id="invullen">
    <h2>Automatisch invullen</h2>
    <p class="muted small">Wat ADONIS voor iedereen alvast invult of voorstelt op een werkopdracht. Zet uit wat u niet wilt, en vul uw eigen
      vaste werkzaamheden en onderdelen aan: die komen bovenaan in de suggesties tijdens het typen.</p>
    <form method="post" action="/systeem/invullen" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="notify-grid af-grid">
        <% for (const [k, label, help] of AF_OPTIONS) { %>
        <label class="check big-check"><input type="checkbox" name="af_<%= k %>" <%= af.on[k] ? 'checked' : '' %>>
          <span><b><%= label %></b><br><span class="muted small"><%= help %></span></span></label>
        <% } %>
      </div>
      <fieldset class="af-set">
        <legend>Vaste waarden voor een nieuwe werkopdracht</legend>
        <div class="af-row">
          <label>Uurtarief <input name="tarief" value="<%= af.vast.tarief %>" inputmode="decimal" placeholder="bijv. 62,50" class="af-short"></label>
          <label>Contact bij extra kosten boven € <input name="contact_boven" value="<%= af.vast.contact_boven %>" inputmode="decimal" placeholder="bijv. 150" class="af-short"></label>
          <label>Alle noodzakelijke reparaties uitvoeren
            <select name="alle_reparaties"><option value="">Niet invullen</option><option value="ja" <%= af.vast.alle_reparaties === 'ja' ? 'selected' : '' %>>Ja</option><option value="nee" <%= af.vast.alle_reparaties === 'nee' ? 'selected' : '' %>>Nee</option></select></label>
        </div>
        <p class="muted small">Leeg laten = niets invullen (het uurtarief komt dan van de vorige werkopdracht, als dat hierboven aan staat).</p>
      </fieldset>
      <div class="af-lists">
        <label>Eigen werkzaamheden <span class="muted small">(één per regel)</span>
          <textarea name="werk" rows="7" placeholder="Kleine beurt volgens fabrieksvoorschrift&#10;Grote beurt + interieurfilter&#10;APK-keuring en afmelden"><%= af.werk.join('\n') %></textarea></label>
        <label>Eigen onderdelen <span class="muted small">(één per regel: omschrijving ; prijs ; onderdeelnummer)</span>
          <textarea name="onderdelen" rows="7" placeholder="Oliefilter ; 12,50&#10;Motorolie 5W30 per liter ; 14,95&#10;Ruitenwisserblad set ; 24,95 ; WB-600"><%= af.onderdelen.join('\n') %></textarea></label>
      </div>
      <div><button class="btn btn-primary" type="submit">Opslaan</button></div>
    </form>
  </section>

  <% const FD = feesten; %>
  <section class="card feest-card" id="feestdagen">
    <h2>Feestdagen</h2>
    <p class="muted small">Een feestelijke achtergrond, rustig achter de knoppen: sneeuw met Kerst, pepernoten met Sinterklaas, vuurwerk met
      Oud en Nieuw enzovoort. Kies per feest van wanneer tot wanneer (dag-maand, elk jaar hetzelfde). Overlappen er twee, dan wint de kortste.
      Iedereen kan het voor zichzelf uitzetten bij <i>Instellingen → Effecten</i>.</p>
    <form method="post" action="/systeem/feestdagen" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="check big-check"><input type="checkbox" name="feesten" <%= FD.aan ? 'checked' : '' %>>
        <span><b>Feestelijke achtergronden aan</b><% if (FD.now) { %> <span class="feest-now">Nu: <%= FD.list.find((f) => f.key === FD.now).name %></span><% } %></span></label>
      <div class="table-wrap">
      <table class="list feest-table">
        <thead><tr><th>Feest</th><th>Van</th><th>Tot en met</th><th></th></tr></thead>
        <tbody>
        <% for (const f of FD.list) { %>
          <tr class="<%= f.actief ? 'is-now' : '' %>">
            <td><label class="check"><input type="checkbox" name="f_<%= f.key %>" <%= f.aan ? 'checked' : '' %>>
              <span><b><%= f.name %></b><% if (f.actief) { %> <span class="feest-now">nu</span><% } %><br><span class="muted small"><%= f.desc %></span></span></label></td>
            <% if (f.canAuto) { %>
            <td colspan="2" class="feest-auto">
              <label class="check small"><input type="checkbox" name="f_<%= f.key %>_auto" <%= f.auto ? 'checked' : '' %>>
                Automatisch: Goede Vrijdag t/m Tweede Paasdag <span class="muted">(dit jaar <%= f.easter.van %> t/m <%= f.easter.tot %>)</span></label>
              <span class="feest-manual small muted">of zelf:
                <input class="feest-date" name="f_<%= f.key %>_van" value="<%= f.van || '' %>" placeholder="dd-mm" inputmode="numeric" aria-label="<%= f.name %> van (dag-maand)"> t/m
                <input class="feest-date" name="f_<%= f.key %>_tot" value="<%= f.tot || '' %>" placeholder="dd-mm" inputmode="numeric" aria-label="<%= f.name %> tot en met (dag-maand)"></span>
            </td>
            <% } else { %>
            <td><input class="feest-date" name="f_<%= f.key %>_van" value="<%= f.van %>" placeholder="dd-mm" inputmode="numeric" aria-label="<%= f.name %> van (dag-maand)"></td>
            <td><input class="feest-date" name="f_<%= f.key %>_tot" value="<%= f.tot %>" placeholder="dd-mm" inputmode="numeric" aria-label="<%= f.name %> tot en met (dag-maand)"></td>
            <% } %>
            <td class="right"><button type="button" class="btn btn-small" data-feest-preview="<%= f.key %>">Bekijken</button></td>
          </tr>
        <% } %>
        </tbody>
      </table>
      </div>
      <div><button class="btn btn-primary" type="submit">Opslaan</button></div>
    </form>
  </section>

  <% const Bs = brand; const sysTheme = ['system', 'light', 'dark'].includes(prefs.theme || 'system'); %>
  <section class="card brand-card" id="huisstijl" data-brand-card data-csrf="<%= csrf %>">
    <h2>Huisstijl</h2>
    <p class="muted small">Geef ADONIS de naam en het logo van uw bedrijf. Iedereen ziet ze in het menu, op de inlogpagina, in de titel van het
      venster en in de opstartanimatie. ADONIS zelf blijft klein zichtbaar onderaan (in de statusbalk en het gebruikersmenu).</p>

    <div class="brand-grid">
      <form method="post" action="/systeem/huisstijl" class="stack brand-form" data-brand-form>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Naam van het bedrijf
          <input name="naam" value="<%= Bs.naam %>" maxlength="40" placeholder="ADONIS" autocomplete="organization" data-brand-name>
          <span class="muted small">Leeg laten = ADONIS.</span></label>
        <label>Ondertitel <span class="muted small">(optioneel)</span>
          <input name="sub" value="<%= Bs.sub %>" maxlength="40" placeholder="bijv. Autobedrijf · APK · Banden" data-brand-sub></label>
        <label class="check"><input type="checkbox" name="bannerInMenu" <%= Bs.bannerInMenu ? 'checked' : '' %> <%= Bs.banner ? '' : 'disabled' %> data-brand-bannermenu>
          Banner in het menu tonen in plaats van logo en naam<% if (!Bs.banner) { %> <span class="muted small">(eerst een banner kiezen)</span><% } %></label>

        <fieldset class="brand-bgset brand-colors" data-brand-colors>
          <legend>Kleuren</legend>
          <label class="check"><input type="checkbox" name="eigenKleuren" <%= Bs.kleur1 || Bs.kleur2 ? 'checked' : '' %> data-brand-own> Eigen kleuren gebruiken
            <span class="muted small">(anders ADONIS-blauw en -goud)</span></label>
          <div class="brand-color-row">
            <label class="brand-color"><input type="color" name="kleur1" value="<%= Bs.kleur1 || '#233fb8' %>" data-brand-c1><span><b>Hoofdkleur</b><span class="muted small">knoppen, links, menu</span></span></label>
            <label class="brand-color"><input type="color" name="kleur2" value="<%= Bs.kleur2 || '#e2b44b' %>" data-brand-c2><span><b>Tweede kleur</b><span class="muted small">accenten, lijn onder het menu</span></span></label>
          </div>
          <p class="muted small">Net als de achtergrond alleen bij de thema's Systeem, Licht en Donker. Bij een lichte hoofdkleur (zoals geel) wordt de tekst op knoppen vanzelf donker.</p>
        </fieldset>
        <fieldset class="brand-bgset"<%= Bs.achtergrond ? '' : ' disabled' %>>
          <legend>Achtergrond</legend>
          <% if (!Bs.achtergrond) { %><p class="muted small">Kies eerst een achtergrondafbeelding hiernaast.</p><% } %>
          <label class="brand-range">Vervaging <output data-out="blur"><%= Bs.blur %> px</output>
            <input type="range" name="blur" min="0" max="40" step="1" value="<%= Bs.blur %>" data-brand-blur></label>
          <label class="brand-range">Zichtbaarheid <output data-out="zicht"><%= Bs.zicht %>%</output>
            <input type="range" name="zicht" min="5" max="100" step="1" value="<%= Bs.zicht %>" data-brand-zicht></label>
          <p class="muted small">De achtergrond is alleen te zien bij de thema's Systeem, Licht en Donker.
            <% if (!sysTheme) { %><b>U gebruikt nu een ander thema</b>, dus u ziet hem zelf niet.<% } %></p>
        </fieldset>
        <div><button class="btn btn-primary" type="submit">Opslaan</button></div>
      </form>

      <div class="brand-preview" aria-label="Voorbeeld">
        <span class="muted small">Voorbeeld in het menu</span>
        <div class="brand-pv-bar" data-brand-pv><%- include('/partials/logo', { noBanner: false }) %></div>
        <span class="muted small">Voorbeeld van de achtergrond</span>
        <div class="brand-pv-bg"><% if (Bs.achtergrond) { %><div class="brand-pv-img" data-brand-pv-img></div><% } %>
          <div class="brand-pv-card"><b>Werkopdracht 1024</b><span class="muted small">Kaarten en tabellen blijven goed leesbaar.</span></div>
          <% if (!Bs.achtergrond) { %><span class="muted small brand-pv-none">Geen achtergrond</span><% } %></div>
      </div>
    </div>

    <div class="brand-files">
      <% for (const [slot, label, help] of [['logo', 'Logo', 'Vierkant, bijv. 512 × 512. Ook het pictogram in het tabblad.'], ['banner', 'Banner', 'Breed logo of naam, bijv. 1200 × 300. Op de inlogpagina.'], ['achtergrond', 'Achtergrond', 'Een rustige foto, bijv. de werkplaats. Liggend.']]) { const url = Bs[slot]; %>
      <div class="brand-file brand-file-<%= slot %>">
        <div class="brand-thumb<%= url ? '' : ' is-empty' %>"><% if (url) { %><img src="<%= url %>" alt="<%= label %>"><% } else { %><span class="muted small">Geen <%= label.toLowerCase() %></span><% } %></div>
        <div class="brand-file-info"><b><%= label %></b><span class="muted small"><%= help %></span>
          <div class="brand-file-actions">
            <label class="btn btn-small"><input type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden data-brand-file="<%= slot %>"><%= url ? 'Vervangen…' : 'Kiezen…' %></label>
            <% if (url) { %><button class="btn btn-small btn-ghost" type="submit" form="brandDel-<%= slot %>">Verwijderen</button><% } %>
          </div>
        </div>
      </div>
      <% if (url) { %><form id="brandDel-<%= slot %>" method="post" action="/systeem/huisstijl/<%= slot %>/verwijderen" hidden data-confirm="<%= label %> verwijderen?"><input type="hidden" name="_csrf" value="<%= csrf %>"></form><% } %>
      <% } %>
    </div>
    <p class="alert" data-brand-error hidden></p>
    <p class="muted small" data-brand-busy hidden>Afbeelding verwerken…</p>
  </section>

  <section class="card backup-card" id="backup">
    <div class="sys-head">
      <h2>Backups</h2>
      <span class="status-pill status-<%= hCls %>"><%= hLabel %></span>
    </div>
    <p class="muted">Elke dag maakt ADONIS automatisch een backup: één bestand met alle klanten, werkopdrachten, het bandenhotel,
      de voorraad en alle foto's. Stond de computer op het afgesproken tijdstip uit, dan gebeurt het zodra ADONIS weer draait.</p>
    <% if (bk.restored) { %><p class="muted small">Laatst teruggezet: <%= when(bk.restored.at) %><%= bk.restored.manifest ? ' (backup van ' + when(bk.restored.manifest.gemaakt) + ')' : '' %>. De gegevens van daarvoor staan in <code><%= bk.restored.aside %></code>.</p><% } %>

    <dl class="facts sys-facts">
      <dt>Laatste backup</dt>
      <dd><% if (c.last) { %><%= when(c.last.at) %> · <%= c.last.ok ? '✓ gelukt' : '✗ ' + (c.last.error || 'mislukt') %><%= c.last.size ? ' · ' + mb(c.last.size) : '' %><% } else { %>nog nooit<% } %></dd>
      <% if (c.lastOk && (!c.last || !c.last.ok)) { %><dt>Laatste geslaagde</dt><dd><%= when(c.lastOk) %></dd><% } %>
    </dl>
    <div class="sys-actions">
      <form method="post" action="/systeem/backup/nu" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-primary" type="submit">Nu een backup maken</button>
      </form>
      <a class="btn" href="/systeem/backup/download">Backup downloaden</a>
    </div>

    <h3>Waar worden de backups bewaard?</h3>
    <p class="muted small">Kies één of meer mappen. Het veiligst is een plek <b>buiten deze computer</b>: een USB-schijf, een netwerkschijf (NAS),
      of de map van <b>OneDrive, Google Drive of Dropbox</b> op deze computer – die zet de backup dan zelf in de cloud.</p>
    <ul class="backup-folders">
      <% for (const f of bk.folders) { %>
      <li>
        <div class="bf-head">
          <code><%= f.path %></code>
          <% if (f.result) { %><span class="status-pill status-<%= f.result.ok ? 'ok' : 'bad' %>"><%= f.result.ok ? 'laatste keer gelukt' : 'laatste keer mislukt' %></span><% } %>
          <% if (f.path === bk.defaultDir) { %><span class="muted small">(op deze computer zelf – bij een kapotte schijf bent u deze ook kwijt)</span><% } %>
          <form method="post" action="/systeem/backup/map/verwijderen" class="inline" data-confirm="Deze map niet meer gebruiken voor backups? (De backups die er al staan, blijven staan.)">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="i" value="<%= f.i %>">
            <button class="linkbtn" type="submit">niet meer gebruiken</button>
          </form>
        </div>
        <% if (f.result && !f.result.ok) { %><p class="alert small"><%= f.result.error %></p><% } %>
        <% if (f.files.length) { %>
        <details class="bf-files">
          <summary class="muted small"><%= f.files.length %> backup<%= f.files.length === 1 ? '' : 's' %> in deze map – bekijken of terugzetten</summary>
          <table class="list compact">
            <thead><tr><th>Gemaakt</th><th class="num">Grootte</th><th></th></tr></thead>
            <tbody>
            <% for (const b of f.files.slice(0, 40)) { %>
              <tr>
                <td><%= fileWhen(b.name) %><%= /voor-terugzetten/.test(b.name) ? ' (veiligheidsbackup)' : '' %></td>
                <td class="num"><%= mb(b.size) %></td>
                <td class="nowrap">
                  <a href="/systeem/backup/bestand?map=<%= f.i %>&naam=<%= encodeURIComponent(b.name) %>">downloaden</a> ·
                  <form method="post" action="/systeem/backup/terugzetten" class="inline" data-confirm="Alle gegevens terugzetten naar de backup van <%= fileWhen(b.name) %>?&#10;&#10;Alles wat daarna is ingevoerd, verdwijnt uit ADONIS. Er wordt eerst een veiligheidsbackup van de huidige situatie gemaakt, dus dit is terug te draaien. ADONIS start daarna opnieuw op en iedereen moet opnieuw inloggen.">
                    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="map" value="<%= f.i %>"><input type="hidden" name="naam" value="<%= b.name %>">
                    <button class="linkbtn" type="submit">terugzetten</button>
                  </form>
                </td>
              </tr>
            <% } %>
            </tbody>
          </table>
        </details>
        <% } %>
      </li>
      <% } %>
      <% if (!bk.folders.length) { %><li class="alert">Er is geen map ingesteld: er worden geen automatische backups bewaard.</li><% } %>
    </ul>
    <form method="post" action="/systeem/backup/map" class="inline-form backup-add">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input name="folder" placeholder="<%= bk.isWindows ? 'bijv. D:\\ADONIS-backups of C:\\Users\\Naam\\OneDrive\\ADONIS-backups' : 'bijv. /mnt/usb/adonis-backups' %>" autocomplete="off" required>
      <button class="btn" type="submit">Map toevoegen</button>
    </form>

    <h3>Wanneer en hoe lang?</h3>
    <form method="post" action="/systeem/backup/instellingen" class="grid-form backup-settings">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Elke dag om<input type="time" name="time" value="<%= c.time %>"></label>
      <label>Backups bewaren
        <select name="keepDays">
          <% for (const d of [7, 14, 30, 60, 90, 365]) { %><option value="<%= d %>" <%= c.keepDays === d ? 'selected' : '' %>><%= d === 365 ? '1 jaar' : d + ' dagen' %></option><% } %>
        </select>
      </label>
      <button class="btn" type="submit">Opslaan</button>
    </form>
    <p class="muted small">Kies een tijdstip waarop de computer meestal aan staat. Van de oudere backups blijven er altijd minstens 3 bewaard.</p>

    <h3>Terugzetten uit een bestand</h3>
    <p class="muted small">Hebt u een backupbestand (adonis-backup-….zip), bijvoorbeeld van een andere computer of uit de cloud? Kies het hier.
      Er wordt eerst een veiligheidsbackup gemaakt; daarna start ADONIS opnieuw op met de gegevens uit het bestand.</p>
    <div class="restore-upload" data-csrf="<%= csrf %>">
      <label class="btn"><input type="file" accept=".zip,application/zip" id="restoreFile" hidden> Backupbestand kiezen…</label>
      <span class="muted small" id="restoreMsg" aria-live="polite"></span>
    </div>
  </section>

  <section class="card">
    <div class="sys-head">
      <h2>Online bereikbaar (Cloudflare)</h2>
      <% if (cf) { %><span class="status-pill status-<%= on ? cls : 'off' %>"><%= on ? label : 'Uitgeschakeld' %></span><% } %>
    </div>
    <p class="muted">Maakt ADONIS veilig (https, met slotje) bereikbaar op uw eigen domein, ook buiten de werkplaats.
      Er hoeven geen poorten open te staan: ADONIS maakt zelf een beveiligde verbinding met Cloudflare.
      In de werkplaats blijft het gewone adres ook werken.</p>

    <% if (error) { %><div class="alert"><%= error %></div><% } %>

    <% if (cf) { %>
      <dl class="facts sys-facts">
        <% if (cf.hostname) { %><dt>Adres</dt><dd><a href="https://<%= cf.hostname %>" target="_blank" rel="noopener">https://<%= cf.hostname %></a></dd><% } %>
        <dt>Ingesteld</dt><dd><%= fmtDateTime(cf.installedAt.replace('T', ' ').slice(0, 19)) %> door <%= cf.installedBy %><%= cf.manual ? ' (met tunnelsleutel)' : '' %></dd>
        <% if (on && st.message) { %><dt>Melding</dt><dd><%= st.message %></dd><% } %>
      </dl>
      <% if (port && cf.port && cf.port !== port) { %>
        <div class="alert">De tunnel stuurt door naar poort <%= cf.port %>, maar ADONIS draait nu op poort <%= port %>.
          Stel de tunnel hieronder opnieuw in om dit te herstellen.</div>
      <% } %>
      <div class="sys-actions">
        <% if (on) { %>
          <form method="post" action="/systeem/cloudflare/uit" class="inline" data-confirm="Cloudflare-tunnel uitschakelen? ADONIS is dan alleen nog in het eigen netwerk bereikbaar.">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn" type="submit">Uitschakelen</button>
          </form>
        <% } else { %>
          <form method="post" action="/systeem/cloudflare/aan" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary" type="submit">Inschakelen</button>
          </form>
        <% } %>
        <form method="post" action="/systeem/cloudflare/vergeten" class="inline" data-confirm="Cloudflare-instellingen verwijderen uit ADONIS?">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger" type="submit">Instellingen verwijderen</button>
        </form>
      </div>
      <% if (st.log.length) { %>
        <details class="sys-log"><summary>Verbindingslogboek</summary><pre><%= st.log.join('\n') %></pre></details>
      <% } %>
    <% } %>

    <% if (!supported) { %>
      <div class="alert">Automatisch installeren is op dit besturingssysteem niet beschikbaar.</div>
    <% } else { %>
    <details class="sys-install" <%= cf ? '' : 'open' %>>
      <summary><strong><%= cf ? 'Opnieuw instellen' : 'Instellen in één klik' %></strong></summary>
      <ol class="sys-steps">
        <li>Zorg dat uw domein (bijv. <code>revnet.nl</code>) in uw Cloudflare-account staat.</li>
        <li>Maak een API-token aan: Cloudflare → <em>My Profile</em> → <em>API Tokens</em> → <em>Create Token</em> →
          <em>Create Custom Token</em>, met deze rechten:
          <ul>
            <li>Account → <strong>Cloudflare Tunnel</strong> → Edit</li>
            <li>Zone → <strong>DNS</strong> → Edit</li>
            <li>Zone → <strong>Zone</strong> → Read</li>
          </ul>
          Bij <em>Zone Resources</em>: kies uw domein. Kopieer de token.</li>
        <li>Vul hieronder het adres en de token in en klik op <strong>Installeren</strong>. ADONIS regelt de rest:
          tunnel, DNS-record, https-certificaat en het verbindingsprogramma. De token wordt niet bewaard.</li>
      </ol>
      <form method="post" action="/systeem/cloudflare/installeren" class="stack sys-form" id="cfInstall">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>Adres voor ADONIS
          <input name="hostname" value="<%= values.hostname || (cf && cf.hostname) || '' %>" placeholder="adonis.revnet.nl" required autocapitalize="none" spellcheck="false">
        </label>
        <label>Cloudflare API-token
          <input name="api_token" type="password" required autocomplete="off" spellcheck="false">
        </label>
        <button class="btn btn-primary" type="submit">Installeren</button>
        <p class="muted small busy-note" hidden>Bezig… dit kan tot een minuut duren (het verbindingsprogramma wordt gedownload).</p>
      </form>

      <details class="sys-alt">
        <summary>Liever zelf de tunnel aanmaken in het Cloudflare-dashboard?</summary>
        <p class="muted small">Cloudflare → <em>Zero Trust</em> → <em>Networks</em> → <em>Tunnels</em> → <em>Create a tunnel</em>.
          Voeg een <em>Public hostname</em> toe die verwijst naar <code>http://127.0.0.1:<%= port || 3000 %></code>,
          en plak hieronder de sleutel (of het hele installatiecommando).</p>
        <form method="post" action="/systeem/cloudflare/sleutel" class="stack sys-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Adres (alleen ter info) <input name="hostname" placeholder="adonis.revnet.nl" autocapitalize="none" spellcheck="false"></label>
          <label>Tunnelsleutel <input name="tunnel_token" type="password" required autocomplete="off" spellcheck="false"></label>
          <button class="btn" type="submit">Verbinden</button>
        </form>
      </details>
    </details>
    <% } %>
  </section>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<script src="/static/js/system.js?v=<%= assetVersion %>"></script>
<script src="/static/js/branding.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
