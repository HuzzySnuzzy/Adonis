<%- include('/partials/head') %>
<main class="page">
  <h1>Gebruikers</h1>
  <div class="role-help muted small">
    <p><strong>Monteur</strong>: werkopdrachten maken en wijzigen, en naar facturatie sturen.</p>
    <p><strong>Facturatie</strong>: daarnaast werkopdrachten bij facturatie wijzigen, afronden met een factuurnummer en heropenen.</p>
    <p><strong>Beheerder</strong>: alles, plus gebruikers en rollen beheren en werkopdrachten verwijderen.</p>
    <p><strong>Eenvoudige weergave</strong>: voor wie niet zo handig is met computers. Grote knoppen, een startscherm en alleen het belangrijkste in het menu. Dezelfde rechten als de rol.</p>
  </div>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <div class="table-wrap">
  <table class="list">
    <thead><tr><th>Naam</th><th>Gebruikersnaam</th><th>Rol</th><th>Eenvoudige weergave</th><th>Nieuw wachtwoord instellen</th><th></th></tr></thead>
    <tbody>
    <% for (const u of users) { %>
      <tr>
        <td><%= u.name %></td>
        <td><%= u.username %></td>
        <td>
          <% if (u.is_owner) { %>
            <span class="role-owner" title="Eerste account: kan niet worden verwijderd of gedegradeerd">ADONIS-beheerder</span><%= u.id === user.id ? ' (jij)' : '' %>
          <% } else if (u.id === user.id) { %><%= ROLES[u.role] || 'Monteur' %> (jij)<% } else { %>
          <form method="post" action="/gebruikers/<%= u.id %>/rol" class="inline role-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <select name="role" aria-label="Rol van <%= u.name %>" data-autosubmit>
              <% for (const [k, label] of Object.entries(ROLES)) { %><option value="<%= k %>" <%= u.role === k ? 'selected' : '' %>><%= label %></option><% } %>
            </select>
            <noscript><button class="btn btn-small" type="submit">Opslaan</button></noscript>
          </form>
          <% } %>
        </td>
        <td>
          <form method="post" action="/gebruikers/<%= u.id %>/eenvoudig" class="inline simple-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="check" title="Grote knoppen, startscherm, alleen het belangrijkste in het menu">
              <input type="checkbox" name="simple" value="on" <%= u.prefs.simple === 'on' ? 'checked' : '' %> data-autosubmit> <%= u.prefs.simple === 'on' ? 'Aan' : 'Uit' %>
            </label>
            <noscript><button class="btn btn-small" type="submit">Opslaan</button></noscript>
          </form>
        </td>
        <td>
          <% if (!u.is_owner || u.id === user.id) { %>
          <form method="post" action="/gebruikers/<%= u.id %>/wachtwoord" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="password" name="password" placeholder="Nieuw wachtwoord" minlength="8" autocomplete="new-password" required>
            <button class="btn btn-small" type="submit">Opslaan</button>
          </form>
          <% } else { %><span class="muted small">Alleen door de ADONIS-beheerder zelf</span><% } %>
        </td>
        <td>
          <% if (u.id !== user.id && !u.is_owner) { %>
          <form method="post" action="/gebruikers/<%= u.id %>/verwijderen" class="inline" data-confirm="Gebruiker <%= u.username %> verwijderen?">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-small btn-danger" type="submit">Verwijderen</button>
          </form>
          <% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>

  <section class="card">
    <h2>Nieuwe gebruiker</h2>
    <form method="post" action="/gebruikers" class="grid-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Naam <input name="name" placeholder="bv. Collin" autocomplete="off" required></label>
      <label>Gebruikersnaam <input name="username" autocapitalize="none" autocomplete="off" required></label>
      <label>Wachtwoord <input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
      <label>Rol
        <select name="role">
          <% for (const [k, label] of Object.entries(ROLES)) { %><option value="<%= k %>"><%= label %></option><% } %>
        </select>
      </label>
      <label class="check" title="Startscherm met grote knoppen en alleen het belangrijkste in het menu. Later te wijzigen bij deze gebruiker of in diens Instellingen.">
        <input type="checkbox" name="eenvoudig" value="on" checked> Eenvoudige weergave</label>
      <button class="btn btn-primary" type="submit">Gebruiker toevoegen</button>
    </form>
  </section>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
