<%- include('/partials/head') %>
<main class="page">
  <h1>Gebruikers</h1>
  <div class="role-help muted small">
    <p><strong>Monteur</strong>: werkopdrachten maken en wijzigen, en naar facturatie sturen.</p>
    <p><strong>Facturatie</strong>: daarnaast werkopdrachten bij facturatie wijzigen, afronden met een factuurnummer en heropenen.</p>
    <p><strong>Beheerder</strong>: alles, plus gebruikers en rollen beheren en werkopdrachten verwijderen.</p>
    <p><strong>AI-functies</strong>: Claude laten analyseren, opzoeken of foto's uitlezen kost geld per keer. Alleen wie hier toegang heeft kan dat starten;
      beheerders altijd. Opgeslagen resultaten (aandachtspunten, AI-analyses) kan iedereen bekijken.</p>
    <p><strong>Eenvoudige weergave</strong>: voor wie niet zo handig is met computers. Grote knoppen, een startscherm en alleen het belangrijkste in het menu. Dezelfde rechten als de rol.</p>
  </div>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <div class="table-wrap">
  <table class="list">
    <thead><tr><th>Naam</th><th>Gebruikersnaam</th><th>Rol</th><th>AI-functies</th><th>Eenvoudige weergave</th><th>Nieuw wachtwoord instellen</th><th></th></tr></thead>
    <tbody>
    <% for (const u of users) { %>
      <tr>
        <td><span class="user-cell"><%- avatarHtml(u) %><span><%= u.name %></span></span></td>
        <td><%= u.username %></td>
        <td>
          <% if (u.is_owner) { %>
            <span class="role-owner" title="Eerste account: kan niet worden verwijderd of gedegradeerd">ADONIS-beheerder</span><%= u.id === user.id ? ' (u)' : '' %>
          <% } else if (u.id === user.id) { %><%= ROLES[u.role] || 'Monteur' %> (u)<% } else { %>
          <form method="post" action="/gebruikers/<%= u.id %>/rol" class="inline role-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <select name="role" aria-label="Rol van <%= u.name %>" data-autosubmit>
              <% for (const [k, label] of Object.entries(ROLES)) { %><option value="<%= k %>" <%= u.role === k ? 'selected' : '' %>><%= label %></option><% } %>
            </select>
            <noscript><button class="btn btn-small" type="submit">Opslaan</button></noscript>
          </form>
          <% } %>
        </td>
        <td>
          <% if (u.is_admin) { %><span class="muted small" title="Beheerders mogen AI-functies altijd gebruiken">Altijd (beheerder)</span>
          <% } else { %>
          <form method="post" action="/gebruikers/<%= u.id %>/ai" class="inline ai-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="check" title="Mag Claude-functies starten die geld kosten (analyseren, opzoeken, foto's uitlezen)">
              <input type="checkbox" name="ai" value="on" <%= u.can_ai ? 'checked' : '' %> data-autosubmit aria-label="AI-functies voor <%= u.name %>"> <%= u.can_ai ? 'Toegestaan' : 'Geen toegang' %>
            </label>
            <noscript><button class="btn btn-small" type="submit">Opslaan</button></noscript>
          </form>
          <% } %>
        </td>
        <td>
          <form method="post" action="/gebruikers/<%= u.id %>/eenvoudig" class="inline simple-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="check" title="Grote knoppen, startscherm, alleen het belangrijkste in het menu">
              <input type="checkbox" name="simple" value="on" <%= u.prefs.simple === 'on' ? 'checked' : '' %> data-autosubmit> <%= u.prefs.simple === 'on' ? 'Aan' : 'Uit' %>
            </label>
            <noscript><button class="btn btn-small" type="submit">Opslaan</button></noscript>
          </form>
        </td>
        <td>
          <% if (!u.is_owner || u.id === user.id) { %>
          <form method="post" action="/gebruikers/<%= u.id %>/wachtwoord" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="password" name="password" placeholder="Nieuw wachtwoord" minlength="8" autocomplete="new-password" required>
            <button class="btn btn-small" type="submit">Opslaan</button>
          </form>
          <% } else { %><span class="muted small">Alleen door de ADONIS-beheerder zelf</span><% } %>
        </td>
        <td>
          <% if (u.id !== user.id && !u.is_owner) { %>
          <form method="post" action="/gebruikers/<%= u.id %>/verwijderen" class="inline" data-confirm="Gebruiker <%= u.username %> verwijderen?">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-small btn-danger" type="submit">Verwijderen</button>
          </form>
          <% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>

  <section class="card">
    <h2>Nieuwe gebruiker</h2>
    <form method="post" action="/gebruikers" class="grid-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Naam <input name="name" placeholder="bv. Collin" autocomplete="off" required></label>
      <label>Gebruikersnaam <input name="username" autocapitalize="none" autocomplete="off" required></label>
      <label>Wachtwoord <input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
      <label>Rol
        <select name="role">
          <% for (const [k, label] of Object.entries(ROLES)) { %><option value="<%= k %>"><%= label %></option><% } %>
        </select>
      </label>
      <label class="check" title="Startscherm met grote knoppen en alleen het belangrijkste in het menu. Later te wijzigen bij deze gebruiker of in diens Instellingen.">
        <input type="checkbox" name="eenvoudig" value="on" checked> Eenvoudige weergave</label>
      <label class="check" title="Mag Claude-functies starten die geld kosten. Beheerders mogen dit altijd.">
        <input type="checkbox" name="ai" value="on"> AI-functies gebruiken</label>
      <button class="btn btn-primary" type="submit">Gebruiker toevoegen</button>
    </form>
  </section>

  <% if (user.is_owner && users.length > 1) { %>
  <section class="card owner-transfer" id="overdragen">
    <h2>Rol ADONIS-beheerder overdragen</h2>
    <p class="muted small">Er is altijd precies één ADONIS-beheerder (eigenaar): alleen die kan bij <i>Systeem</i> (backups, huisstijl,
      onderdelen, updates) en kan niet worden verwijderd. Draagt u de rol over, dan wordt de ander de ADONIS-beheerder en blijft u
      gewoon beheerder. Terugdraaien kan alleen de nieuwe ADONIS-beheerder.</p>
    <form method="post" action="/gebruikers/eigenaar-overdragen" class="stack narrow-form" data-confirm="Weet u het zeker? U bent daarna geen ADONIS-beheerder meer en kunt niet meer bij Systeem.">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Overdragen aan
        <select name="naar" required>
          <option value="">Kies een gebruiker…</option>
          <% for (const u of users) { if (u.id === user.id) continue; %><option value="<%= u.id %>"><%= u.name %> (<%= u.username %>, <%= (ROLES[u.role] || 'Monteur').toLowerCase() %>)</option><% } %>
        </select></label>
      <label>Uw wachtwoord <span class="muted small">(ter controle)</span>
        <input type="password" name="wachtwoord" autocomplete="current-password" required></label>
      <label class="check"><input type="checkbox" name="bevestig" value="on" required>
        Ik begrijp dat ik daarna geen ADONIS-beheerder meer ben.</label>
      <div><button class="btn btn-danger" type="submit">Rol overdragen</button></div>
    </form>
  </section>
  <% } %>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
