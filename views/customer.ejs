<%- include('/partials/head') %>
<main class="page">
  <p class="crumbs"><a href="/">Alle klanten</a></p>
  <% if (!editing) { %>
  <div class="customer-head<%= locals.carImg && carImg.ok ? ' has-photo' : '' %>" id="live-customer-head" data-live>
    <% if (locals.carQ) { const ci = locals.carImg; %>
    <figure class="car-photo" data-carimg-q="<%= carQ %>" data-csrf="<%= csrf %>" <%= ci && ci.ok ? '' : 'hidden' %>>
      <img src="<%= ci && ci.ok ? ci.img : '' %>" alt="Voorbeeldfoto van een <%= carQ.replace(/\s*\(.*\)$/, '') %>" <%= ci && ci.ok ? '' : 'hidden' %>>
      <button type="button" class="car-wrong" data-carimg-wrong title="Verkeerde auto? Foto verbergen" aria-label="Foto verbergen">×</button>
      <figcaption title="Voorbeeldfoto: kan een andere uitvoering of kleur zijn<%= locals.carYear ? ' (deze auto: ' + carYear + ')' : '' %>. Bron: Wikimedia Commons.">
        Voorbeeldfoto · <a href="<%= ci && ci.ok ? ci.pageUrl : '#' %>" target="_blank" rel="noopener" data-carimg-title><%= ci && ci.ok && ci.title && !/intitle:|insource:/i.test(ci.title) ? ci.title : carQ.replace(/\s*\(.*\)$/, '') %></a>
        <a href="<%= ci && ci.ok && ci.fileUrl ? ci.fileUrl : '#' %>" target="_blank" rel="noopener" data-carimg-file hidden>Wikimedia Commons</a>
      </figcaption>
    </figure>
    <% } %>
    <div>
      <%- include('/partials/plate', { kenteken: customer.kenteken }) %>
      <h1><%= customer.naam || 'Onbekende klant' %></h1>
      <p class="muted"><%= customer.merk_type %></p>
      <% if (customer.status) { %><p class="cust-status-note"><span class="cust-status st-<%= customer.status %>"><%= customer.status === 'weg' ? 'Inactief' : 'Geen herinneringen' %></span>
        <span class="muted small">sinds <%= fmtDate((customer.status_at || '').slice(0, 10)) %> · geen APK-herinneringen, niet op de wissellijst</span></p><% } %>
    </div>
    <dl class="facts">
      <% const facts = [['Klantnr.', customer.klantnr], ['Adres', customer.adres], ['Plaats', customer.plaats],
           ['Tel. privé', customer.tel_prive], ['Tel. zaak', customer.tel_zaak], ['Chassisnummer', customer.chassisnummer], ['Alarmcode', customer.alarmcode]]; %>
      <% for (const [k, v] of facts) { if (v) { %><dt><%= k %></dt><dd><%= v %></dd><% } } %>
    </dl>
    <div class="head-actions">
      <% if (feat.werkopdrachten) { %><a class="btn btn-primary" href="/werkopdracht/nieuw?klant=<%= customer.id %>">+ Nieuwe werkopdracht voor <%= customer.kenteken %></a>
      <% } else if (feat.bandenhotel) { %><a class="btn btn-primary" href="/bandenhotel/nieuw?klant=<%= customer.id %>">+ Banden inslaan voor <%= customer.kenteken %></a><% } %>
      <a class="btn" href="/klant/<%= customer.id %>?bewerken=1#gegevens">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M3 17.25V21h3.75L17.8 9.95l-3.75-3.75L3 17.25zm17.7-10.2a1 1 0 0 0 0-1.4l-2.35-2.35a1 1 0 0 0-1.4 0l-1.85 1.85 3.75 3.75 1.85-1.85z"/></svg>
        Gegevens wijzigen
      </a>
      <form method="post" action="/klant/<%= customer.id %>/status" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (customer.status) { %><input type="hidden" name="status" value=""><button class="btn" type="submit" title="Weer herinneringen voor APK en bandenwissel">Weer actief maken</button>
        <% } else { %><input type="hidden" name="status" value="weg"><button class="btn btn-ghost" type="submit" title="Geen APK-herinneringen en niet op de wissellijst; werkopdrachten blijven bewaard">Op inactief zetten</button><% } %>
      </form>
    </div>
  </div>
  <% } else { const v = editValues || customer; %>
  <form method="post" action="/klant/<%= customer.id %>/bewerken" class="customer-head customer-edit" id="gegevens" autocomplete="off" data-guard>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="edit-head">
      <h1>Klantgegevens wijzigen</h1>
      <p class="muted small">Deze gegevens worden ingevuld op nieuwe werkopdrachten. Bestaande werkopdrachten blijven zoals ze zijn
        (alleen een gewijzigd kenteken wordt overal doorgevoerd). Een <em>nieuwe</em> werkopdracht met andere gegevens werkt de klant weer bij.</p>
    </div>
    <% if (editError) { %><div class="alert"><%= editError %><% if (locals.clashId) { %> <a href="/klant/<%= clashId %>">Naar die klant</a><% } %></div><% } %>
    <div class="grid-form">
      <label>Kenteken<input name="c[kenteken]" value="<%= v.kenteken %>" required autocapitalize="characters" data-1p-ignore data-lpignore="true"></label>
      <label>Naam<input name="c[naam]" value="<%= v.naam %>" data-1p-ignore data-lpignore="true" autofocus></label>
      <label>Klantnr.<input name="c[klantnr]" value="<%= v.klantnr %>" data-1p-ignore data-lpignore="true"></label>
      <label>Merk/Type<input name="c[merk_type]" value="<%= v.merk_type %>" data-1p-ignore data-lpignore="true"></label>
      <label>Adres<input name="c[adres]" value="<%= v.adres %>" data-1p-ignore data-lpignore="true"></label>
      <label>Plaats<input name="c[plaats]" value="<%= v.plaats %>" data-1p-ignore data-lpignore="true"></label>
      <label>Tel. privé<input name="c[tel_prive]" value="<%= v.tel_prive %>" inputmode="tel" data-1p-ignore data-lpignore="true"></label>
      <label>Tel. zaak<input name="c[tel_zaak]" value="<%= v.tel_zaak %>" inputmode="tel" data-1p-ignore data-lpignore="true"></label>
      <label>Chassisnummer<input name="c[chassisnummer]" value="<%= v.chassisnummer %>" class="mono" data-1p-ignore data-lpignore="true"></label>
      <label>Alarmcode<input name="c[alarmcode]" value="<%= v.alarmcode %>" data-1p-ignore data-lpignore="true"></label>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Opslaan</button>
      <a class="btn btn-ghost" href="/klant/<%= customer.id %>">Annuleren</a>
    </div>
  </form>
  <% } %>

  <% if (feat.portaal) { %><%- include('/partials/plate-sites', { plateLinks, kenteken: customer.kenteken }) %><% } %>
  <% if (feat.ai) { %>
  <p class="va-link no-print"><a class="btn btn-small" href="/ai-analyse?kenteken=<%= encodeURIComponent(customer.kenteken) %>"><%- include('/partials/ai-icon') %> AI-analyse van deze auto</a></p>
  <div id="live-bulletins" class="bl-boxes" data-live>
    <% if (feat.werkopdrachten) { %><%- include('/partials/bulletins', { bl: bulletinData, aiOn: aiConfigured && user.can_ai, aiLocked: aiConfigured && !user.can_ai, customer }) %><% } %>
    <%- include('/partials/model-apk', { modelApk, aiOn: aiConfigured && user.can_ai, aiLocked: aiConfigured && !user.can_ai, customer }) %>
  </div>
  <% } %>

  <% const ri = rdwData && rdwData.info; %>
  <section class="rdw-card" aria-label="RDW-gegevens">
    <div class="rdw-head">
      <h2>RDW-gegevens</h2>
      <div class="rdw-links"<%= rdwData && rdwData.foreign ? ' hidden' : '' %>>
        <a href="<%= rdwUrl(customer.kenteken) %>" target="_blank" rel="noopener">Bekijken op rdw.nl</a>
        <form method="post" action="/klant/<%= customer.id %>/rdw" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="linkbtn" type="submit" title="Opnieuw ophalen bij de RDW">Vernieuwen</button>
        </form>
      </div>
    </div>
    <% if (rdwData && rdwData.foreign) { %>
      <p class="muted"><%= rdwData.country === 'D' ? 'Duits kenteken' : 'Geen Nederlands kenteken' %>: de RDW heeft alleen gegevens van Nederlandse kentekens.</p>
    <% } else if (!ri) { %>
      <p class="muted" title="<%= rdwData && rdwData.error ? 'Technische melding: ' + rdwData.error : '' %>">De RDW is op dit moment niet bereikbaar. Probeer later opnieuw.</p>
    <% } else if (!ri.found) { %>
      <p class="muted">Kenteken <strong><%= customer.kenteken %></strong> is niet gevonden bij de RDW. Klopt het kenteken?</p>
    <% } else { const apk = apkStatus(ri.apk); %>
      <div class="rdw-grid">
        <div class="apk-box apk-<%= apk ? apk.cls : 'none' %>">
          <span class="apk-label">APK verloopt</span>
          <% if (apk) { %><strong><%= fmtDate(ri.apk) %></strong><span><%= apk.rel %></span>
          <% } else { %><strong>onbekend</strong><span>niet APK-plichtig of niet bekend</span><% } %>
        </div>
        <dl class="facts rdw-facts">
          <dt>Merk / type</dt><dd><%= rdwMerkType(ri) %></dd>
          <% if (ri.brandstof) { %><dt>Brandstof</dt><dd><%= ri.brandstof %><%= ri.vermogenKw ? ` · ${ri.vermogenKw} kW (${ri.vermogenPk} pk)` : '' %></dd><% } %>
          <% if (ri.eersteToelating) { %><dt>Eerste toelating</dt><dd><%= fmtDate(ri.eersteToelating) %><%= ri.eersteToelatingNL && ri.eersteToelatingNL !== ri.eersteToelating ? ' (in NL sinds ' + fmtDate(ri.eersteToelatingNL) + ')' : '' %></dd><% } %>
          <% if (ri.kleur) { %><dt>Kleur</dt><dd><%= ri.kleur %></dd><% } %>
          <% if (ri.cilinderinhoud) { %><dt>Cilinderinhoud</dt><dd><%= ri.cilinderinhoud %> cc</dd><% } %>
          <% if (ri.emissie) { %><dt>Emissie</dt><dd><%= ri.emissie %></dd><% } %>
          <% if (ri.tellerstand) { %><dt>Tellerstand</dt><dd><%= ri.tellerstand %></dd><% } %>
          <% if (ri.verzekerd !== null) { %><dt>WA-verzekerd</dt><dd><%= ri.verzekerd ? 'Ja' : 'Nee' %></dd><% } %>
        </dl>
      </div>
      <% if (ri.terugroepactie) { %><div class="rdw-warn">Er staat een <strong>openstaande terugroepactie</strong> op dit voertuig. Bekijk de details op rdw.nl.</div><% } %>
      <% if (ri.export) { %><div class="rdw-warn">Dit voertuig is geëxporteerd.</div><% } %>
      <% if (ri.wachtOpKeuring) { %><div class="rdw-warn">Wacht op keuring: <%= ri.wachtOpKeuring %></div><% } %>
      <p class="muted small rdw-src">Bron: RDW Open Data<%= rdwData.at ? ' · opgehaald ' + fmtDateTime(rdwData.at) : '' %></p>
    <% } %>
  </section>

  <%
    const klantTyres = tyres.filter((t) => t.soort !== 'opslag');
    const onCar = klantTyres.find((t) => t.status === 'op_auto');
    const stored = tyres.filter((t) => t.status === 'opgeslagen');
    const history = tyres.filter((t) => t.status === 'uitgegeven');
    const carCls = onCar ? seasonClass(onCar.seizoen) : null;
    const match = stored.find((t) => t.soort !== 'opslag' && seasonClass(t.seizoen) === swapTarget);
    const needsSwap = match && carCls !== swapTarget && carCls !== 'all';
  %>
  <% if (feat.bandenhotel) { %>
  <section class="rdw-card tyre-card" aria-label="Banden" id="banden">
    <div class="rdw-head">
      <h2>Banden</h2>
      <div class="rdw-links"><a href="/bandenhotel/wissellijst">Wissellijst</a><a href="/bandenhotel/nieuw?klant=<%= customer.id %>">+ Banden inslaan</a></div>
    </div>
    <div class="oncar">
      <span class="oncar-label">Op de auto</span>
      <% if (onCar) { %>
        <a class="oncar-set" href="/bandenhotel/<%= onCar.id %>">
          <% if (onCar.seizoen) { %><span class="season season-<%= carCls || 'mix' %>"><%= onCar.seizoen %></span><% } %>
          <% if (onCar.maat) { %><span><%= onCar.maat %></span><% } %>
          <%- include('/partials/tread', { t: onCar }) %>
          <span class="muted small"><%= onCar.datum_uit ? 'sinds ' + fmtDate(onCar.datum_uit) : '' %></span>
        </a>
      <% } else { %>
        <span class="muted">Niet vastgelegd</span>
      <% } %>
      <details class="oncar-edit">
        <summary class="linkbtn"><%= onCar ? 'Wijzigen' : 'Vastleggen' %></summary>
        <form method="post" action="/klant/<%= customer.id %>/op-auto" class="grid-form oncar-form" autocomplete="off">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Seizoen<select name="op[seizoen]">
            <% for (const sz of ['', ...SEASONS]) { %><option value="<%= sz %>" <%= (onCar ? seasonClass(onCar.seizoen) : '') === seasonClass(sz) && (onCar || !sz) ? 'selected' : '' %>><%= sz || 'Onbekend' %></option><% } %>
          </select></label>
          <label>Maat<input name="op[maat]" value="<%= onCar ? onCar.maat : (stored[0] ? stored[0].maat : '') %>" placeholder="205/55R16"></label>
          <label>Profiel voor (mm)<input name="op[profiel_voor]" value="<%= onCar ? fmtMm(onCar.profiel_voor) : '' %>" inputmode="decimal"></label>
          <label>Profiel achter (mm)<input name="op[profiel_achter]" value="<%= onCar ? fmtMm(onCar.profiel_achter) : '' %>" inputmode="decimal"></label>
          <button class="btn btn-small btn-primary" type="submit">Opslaan</button>
        </form>
      </details>
    </div>
    <% if (needsSwap) { %>
    <div class="swap-hint">
      <span>Komende wissel: <b><%= match.seizoen.toLowerCase() %>banden</b> liggen klaar in <%= match.locatie || 'de opslag' %><%= match.label && match.label.length <= 12 ? ' (label ' + match.label + ')' : '' %>.<%= match.uitgenodigd_at ? ' Gebeld op ' + fmtDate(match.uitgenodigd_at) + '.' : '' %></span>
      <a class="btn btn-small btn-primary" href="/bandenhotel/<%= match.id %>/wissel" data-swap>Wisselen</a>
    </div>
    <% } %>
    <div id="live-customer-tyres" data-live>
    <% if (!stored.length) { %>
      <p class="muted small">Geen banden van <%= customer.kenteken %> in opslag.</p>
    <% } else { %>
      <p class="muted small"><%= stored.length %> set<%= stored.length === 1 ? '' : 's' %> in opslag</p>
      <%- include('/partials/tyrelist', { tyres: stored, showPlate: false, showStatus: true }) %>
    <% } %>
    <% if (history.length) { %>
      <details class="tyre-history"><summary class="muted small">Eerder uitgegeven (<%= history.length %>)</summary>
        <%- include('/partials/tyrelist', { tyres: history, showPlate: false, showStatus: true }) %>
      </details>
    <% } %>
    </div>
  </section>
  <% } %>

  <% if (feat.werkopdrachten) { %>
  <div class="page-head">
    <h2>Werkopdrachten</h2>
    <form class="search" method="get" role="search" autocomplete="off">
      <input type="search" name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" data-1p-ignore data-lpignore="true" value="<%= q %>" placeholder="Zoek in werkopdrachten (bv. accu, U1F1B, distributie)…">
      <button class="btn" type="submit">Zoeken</button>
      <% if (q) { %><a class="btn btn-ghost" href="/klant/<%= customer.id %>">Wissen</a><% } %>
    </form>
  </div>
  <div id="live-customer-orders" data-live>
  <%- include("/partials/search-hint") %>
  <% if (orders.length === 0) { %>
    <div class="empty"><p>Geen werkopdrachten gevonden<%= q ? ' voor “' + q + '”' : '' %>.</p></div>
  <% } else { %>
    <%- include('/partials/orderlist', { orders, showPlate: false }) %>
  <% } %>
  </div>
  <% } %>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<script src="/static/js/ai.js?v=<%= assetVersion %>"></script>
<script src="/static/js/photos.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
