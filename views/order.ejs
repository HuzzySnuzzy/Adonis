<%- include('/partials/head', { extraCss: 'werkopdracht.css', bodyClass: 'order-page' }) %>
<%
  const d = data;
  const lined = (field, extra = '') =>
    `<textarea class="ink lined" name="d[${field}]" rows="${WORK_LINES}" spellcheck="false" ${extra}>${esc(d[field])}</textarea>`;
  const achter = (field, rows) =>
    `<textarea class="ink lined" name="d[achter][${field}]" rows="${rows}" spellcheck="false">${esc(d.achter[field])}</textarea>`;
  const dv = d.diversen;
  const box = (field, label) =>
    `<label class="box"><input type="checkbox" name="d[diversen][${field}]" ${dv[field] ? 'checked' : ''}> ${label}</label>`;
%>

<% if (draft) { %>
<div class="order-toolbar import-toolbar no-print">
  <div class="tb-left">
    <div class="tb-title">
      <strong>Import controleren</strong>
      <span class="muted small">Nog niet opgeslagen. Vergelijk met de foto, verbeter waar nodig en bevestig.</span>
    </div>
  </div>
  <div class="tb-right">
    <button class="btn btn-danger" type="submit" form="cancelImportForm">Annuleren</button>
    <button class="btn btn-primary" type="submit" form="orderForm" id="saveBtn">Bevestigen en opslaan</button>
    <% if (user.can_invoice) { %><button class="btn btn-ok" type="submit" form="orderForm" name="next_status" value="gefactureerd" title="Opslaan en meteen als gefactureerd afronden (oude, al gefactureerde werkopdracht)">Bevestigen als gefactureerd</button><% } %>
  </div>
</div>
<form id="cancelImportForm" method="post" action="/importeren/<%= draft.id %>/annuleren" class="no-print"
      data-confirm="Import annuleren? De uitgelezen gegevens worden weggegooid.">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
</form>
<section class="import-review no-print">
  <% if (draft.onzeker && draft.onzeker.length) { %>
  <div class="import-warn">
    <strong>Controleer deze punten extra goed:</strong>
    <ul><% for (const o of draft.onzeker) { %><li><%= o %></li><% } %></ul>
  </div>
  <% } else { %>
  <div class="import-ok">Alles leek goed leesbaar. Controleer de gegevens toch even met de foto.</div>
  <% } %>
  <details class="import-photos" open>
    <summary>Foto's (<%= draft.imageCount %>) – tik om te vergroten</summary>
    <div class="photo-strip">
      <% for (let i = 0; i < draft.imageCount; i++) { %>
        <a href="/importeren/<%= draft.id %>/foto/<%= i %>" target="_blank" rel="noopener"><img src="/importeren/<%= draft.id %>/foto/<%= i %>" alt="Foto <%= i + 1 %>"></a>
      <% } %>
    </div>
  </details>
</section>
<% } else { %>
<div class="order-toolbar no-print">
  <div class="tb-left">
    <% if (order) { %>
      <a class="btn btn-ghost" href="/klant/<%= order.customer_id %>" data-back-link>Klant</a>
    <% } else { %>
      <a class="btn btn-ghost" href="/" data-back-link>Terug</a>
    <% } %>
    <div class="tb-title">
      <strong><%= order ? 'Werkopdracht ' + order.nummer : 'Nieuwe werkopdracht' %>
        <% if (order) { %><span class="status-badge status-<%= order.status %>"><%= STATUSES[order.status] %></span><% } %></strong>
      <% if (order) { %>
        <span class="muted small">Aangemaakt door <%= order.created_by_name || 'onbekend' %> op <%= fmtDateTime(order.created_at) %>
        <% if (order.updated_at !== order.created_at) { %> · gewijzigd door <%= order.updated_by_name || 'onbekend' %> op <%= fmtDateTime(order.updated_at) %><% } %></span>
      <% } %>
    </div>
  </div>
  <div class="tb-right">
    <span class="totals muted small" id="totals" title="Som van aantal × prijs p.eenh. van onderdelen, vloeistoffen en diversen"></span>
    <div class="tb-tools">
    <% if (editable) { %>
    <details class="nav-menu tpl-menu" data-nav-menu data-tpl-menu>
      <summary class="btn btn-ghost">Sjabloon</summary>
      <div class="nav-pop nav-pop-right" role="menu">
        <% if (templates.length) { %><p class="bell-head">Invullen met</p><% } %>
        <% for (const t of templates) { %><button type="button" role="menuitem" data-tpl-apply="<%= t.id %>"><%= t.naam %></button><% } %>
        <div class="nav-pop-form">
          <button type="button" role="menuitem" data-tpl-save>Opslaan als sjabloon…</button>
          <a role="menuitem" href="/sjablonen">Sjablonen beheren</a>
        </div>
      </div>
    </details>
    <% } %>
    <a class="btn btn-ghost" href="#achterkant">Achterkant</a>
    <button class="btn" type="button" id="printBtn">Afdrukken</button>
    </div>
    <div class="tb-actions"><%- include('/partials/order-actions', { where: 'top' }) %></div>
  </div>
</div>
<% if (order) { %>
  <form id="statusOpen" method="post" action="/werkopdracht/<%= order.id %>/status" hidden
        <% if (user.can_invoice) { %>data-confirm="Werkopdracht terugsturen naar de monteur (status Open)?"<% } %>>
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="open">
  </form>
  <form id="statusReopen" method="post" action="/werkopdracht/<%= order.id %>/status" hidden
        data-confirm="Gefactureerde werkopdracht heropenen? Hij komt weer bij facturatie te staan.">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="klaar">
  </form>
  <% if (order.status === 'klaar') { %>
    <div class="status-bar status-bar-klaar no-print">
      <strong>Klaar voor facturatie</strong> · door <%= order.status_by_name || 'onbekend' %> op <%= fmtDateTime(order.status_at) %>.
      <% if (user.can_invoice) { %>
        Controleer de werkopdracht, vul het factuurnummer in (onderaan: <em>Factuurnummer</em>) en klik op <strong>Afronden</strong>.
      <% } else { %>
        U kunt hem nu alleen bekijken. Moet er nog iets veranderen? Klik op <strong>Terughalen naar Open</strong>.
      <% } %>
    </div>
  <% } else if (order.status === 'gefactureerd') { %>
    <div class="status-bar status-bar-gefactureerd no-print">
      <strong>Gefactureerd</strong><%= data.faktuurnr ? ' · factuurnummer ' + data.faktuurnr : '' %> · door <%= order.status_by_name || 'onbekend' %> op <%= fmtDateTime(order.status_at) %>.
      Deze werkopdracht is vergrendeld<%= user.can_invoice ? ' – klik op Heropenen om iets te wijzigen' : '' %>.
    </div>
  <% } %>
<% } %>

<% } %>

<% if (error) { %><div class="alert alert-wide no-print"><%= error %></div><% } %>

<% if (locals.plateLinks && plateLinks.length && feat.portaal) { %><div class="order-plate-sites"><%- include('/partials/plate-sites', { plateLinks, kenteken: data.kenteken }) %></div><% } %>
<% if (locals.orderBulletins) { %><div class="order-bulletins bl-boxes">
  <% if (orderBulletins.bl.open.length && feat.ai) { %><%- include('/partials/bulletins', { bl: orderBulletins.bl, aiOn: false, customer: orderBulletins.customer, compact: true }) %><% } %>
  <% if (feat.ai) { %><%- include('/partials/model-apk', { modelApk: orderBulletins.modelApk, aiOn: false, customer: orderBulletins.customer, compact: true }) %><% } %>
</div><% } %>
<% if (order) { %><span hidden id="live-order" data-id="<%= order.id %>"></span><% } %>
<form id="orderForm" method="post" action="<%= draft ? '/importeren/' + draft.id + '/bevestigen' : order ? '/werkopdracht/' + order.id : '/werkopdracht' %>" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="zonder_factuurnr" value="">
  <% if (order) { %><input type="hidden" name="versie" value="<%= order.updated_at %>"><% } %>

  <fieldset class="order-fieldset"<%= editable ? '' : ' disabled' %>>
  <!-- ===================== VOORKANT ===================== -->
  <div class="sheet-scroll">
  <section class="sheet front" aria-label="Voorkant werkopdracht">

    <!-- ---------- linkerhelft: onderdelen ---------- -->
    <div class="panel panel-left">
      <div class="red-nr mirror-nr"><%= nummer %></div>
      <table class="grid parts">
        <colgroup><col class="c-rownum"><col class="c-partnr"><col><col class="c-qty"><col class="c-price"></colgroup>
        <thead>
          <tr><th colspan="2">Onderdeelnummer</th><th>Omschrijving</th><th class="center">Aantal</th><th class="center">Prijs p.eenh.</th></tr>
        </thead>
        <tbody>
        <% d.onderdelen.forEach((p, i) => { %>
          <tr data-line>
            <td class="rownum"><%= i + 1 %></td>
            <td><%- inp(`onderdelen.${i}.nr`, p.nr) %></td>
            <td><%- inp(`onderdelen.${i}.omschrijving`, p.omschrijving) %></td>
            <td><%- inp(`onderdelen.${i}.aantal`, p.aantal, 'class="ink center" data-qty') %></td>
            <td><%- inp(`onderdelen.${i}.prijs`, p.prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>

      <div class="bottom-split">
        <table class="grid fluids">
          <colgroup><col class="c-liter"><col><col class="c-price"></colgroup>
          <thead><tr><th>Liter</th><th>Omschrijving</th><th class="center">Prijs p.eenh.</th></tr></thead>
          <tbody>
          <% FLUIDS.forEach((f) => { const v = d.vloeistoffen[f.key]; %>
            <tr data-line>
              <td><%- inp(`vloeistoffen.${f.key}.liter`, v.liter, 'class="ink center" data-qty') %></td>
              <td><div class="labelled">
                <% if (f.kind === 'visc') { %>
                  <span class="lbl"><%= f.label %></span>
                  <%- inp(`vloeistoffen.${f.key}.info`, v.info, 'class="ink center visc" aria-label="Viscositeit (eerste getal)"') %>
                  <span class="lbl">w</span>
                  <%- inp(`vloeistoffen.${f.key}.info2`, v.info2, 'class="ink center visc" aria-label="Viscositeit (tweede getal)"') %>
                <% } else if (f.label) { %>
                  <span class="lbl"><%= f.label %></span>
                  <%- inp(`vloeistoffen.${f.key}.info`, v.info, `aria-label="${f.label}"`) %>
                  <% if (f.suffix) { %><span class="lbl"><%= f.suffix %></span><% } %>
                <% } else { %>
                  <%- inp(`vloeistoffen.${f.key}.info`, v.info) %>
                <% } %>
              </div></td>
              <td><%- inp(`vloeistoffen.${f.key}.prijs`, v.prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>

        <table class="grid diversen">
          <colgroup><col><col class="c-price"></colgroup>
          <thead><tr><th>Diversen</th><th class="center">Prijs p.eenh.</th></tr></thead>
          <tbody>
            <tr data-line>
              <td><div class="labelled"><span class="lbl">Servicewagen</span><%- inp('diversen.servicewagen_km', dv.servicewagen_km, 'class="ink right" inputmode="numeric"') %><span class="lbl">km</span></div></td>
              <td><%- inp('diversen.servicewagen_prijs', dv.servicewagen_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
            <tr data-line>
              <td><div class="labelled"><span class="lbl">Leenauto</span><%- inp('diversen.leenauto_km', dv.leenauto_km, 'class="ink right" inputmode="numeric"') %><span class="lbl">km</span></div></td>
              <td><%- inp('diversen.leenauto_prijs', dv.leenauto_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
            <tr data-line>
              <td><div class="labelled"><span class="lbl">Werk derden</span><%- inp('diversen.werk_derden', dv.werk_derden) %></div></td>
              <td><%- inp('diversen.werk_derden_prijs', dv.werk_derden_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
            <tr data-line>
              <td><div class="labelled boxes"><%- box('apk', 'APK') %><%- box('afmeldkosten', 'Afmeldkosten') %></div></td>
              <td><%- inp('diversen.apk_prijs', dv.apk_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
            <tr data-line>
              <td><div class="labelled"><span class="lbl">Testapparatuur</span><%- inp('diversen.testapparatuur', dv.testapparatuur) %></div></td>
              <td><%- inp('diversen.testapparatuur_prijs', dv.testapparatuur_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
            <tr data-line>
              <td><%- inp('diversen.extra', dv.extra) %></td>
              <td><%- inp('diversen.extra_prijs', dv.extra_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
            <tr data-line>
              <td><div class="labelled boxes"><%- box('uitlijnen', 'Uitlijnen') %><%- box('balanceren', 'Balanceren') %></div></td>
              <td><%- inp('diversen.uitlijnen_prijs', dv.uitlijnen_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
            <tr data-line>
              <td><div class="labelled"><span class="lbl">Kleinmateriaal</span><%- inp('diversen.kleinmateriaal', dv.kleinmateriaal) %></div></td>
              <td><%- inp('diversen.kleinmateriaal_prijs', dv.kleinmateriaal_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
            <tr data-line>
              <td><div class="labelled"><span class="lbl">Milieutoeslag</span><%- inp('diversen.milieutoeslag', dv.milieutoeslag) %></div></td>
              <td><%- inp('diversen.milieutoeslag_prijs', dv.milieutoeslag_prijs, 'class="ink right" inputmode="decimal" data-price') %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ---------- rechterhelft: werkopdracht ---------- -->
    <div class="panel panel-right">
      <div class="head-grid">
        <div class="cell"><span class="lbl">Monteur</span><%- inp('monteur', d.monteur) %></div>
        <div class="cell title-cell">
          <span class="wo-title">WERKOPDRACHT</span>
          <input class="red-nr nr-input" name="nummer" value="<%= nummer %>" inputmode="numeric" required placeholder="nr." aria-label="Werkopdrachtnummer" autocomplete="off">
        </div>

        <div class="cell"><span class="lbl">Datum invoer</span><% if (draft) { %><input class="ink<%= datumInvoer && draft.result.datum_bron !== 'gereed' ? '' : ' needs-check' %>" type="date" name="datum_invoer" value="<%= datumInvoer %>" required title="<%= draft.result.datum_bron === 'gereed' ? 'Overgenomen van Datum gereed – controleer' : 'Datum van de papieren werkopdracht' %>"><% } else if (order) { %><input class="ink" type="date" name="datum_invoer" value="<%= datumInvoer %>" required title="Datum van de werkopdracht (aan te passen)"><% } else { %><span class="ink static" title="Wordt automatisch ingevuld bij aanmaken"><%= fmtDate(datumInvoer) %></span><% } %></div>
        <div class="cell"><span class="lbl">Naam</span><%- inp('naam', d.naam) %></div>

        <div class="cell"><span class="lbl">Datum gereed</span><%- inp('datum_gereed', d.datum_gereed, 'type="date"') %></div>
        <div class="cell"><span class="lbl">Adres</span><%- inp('adres', d.adres) %></div>

        <div class="cell"><span class="lbl">Klantnr.</span><%- inp('klantnr', d.klantnr) %></div>
        <div class="cell"><span class="lbl">Plaats</span><%- inp('plaats', d.plaats) %></div>

        <div class="cell"><span class="lbl">Kenteken</span><%- inp('kenteken', d.kenteken, 'class="ink upper" required autocapitalize="characters" placeholder="verplicht" data-rdw-plate') %><button type="button" class="rdw-btn no-print" id="rdwBtn" title="Voertuiggegevens bij de RDW opzoeken">RDW</button></div>
        <div class="cell"><span class="lbl">Tel. privé</span><%- inp('tel_prive', d.tel_prive, 'type="tel"') %></div>

        <div class="cell"><span class="lbl">Merk/Type</span><%- inp('merk_type', d.merk_type) %></div>
        <div class="cell"><span class="lbl">Tel. zaak</span><%- inp('tel_zaak', d.tel_zaak, 'type="tel"') %></div>

        <div class="cell"><span class="lbl">Km-stand (werkelijk)</span><%- inp('km_in', d.km_in, 'inputmode="numeric"') %><span class="lbl">(in)</span></div>
        <div class="cell"><span class="lbl">Alle noodzakelijke reparaties uitvoeren</span>
          <span class="janee">
            <label><input type="radio" name="d[alle_reparaties]" value="ja" <%= d.alle_reparaties === 'ja' ? 'checked' : '' %>><span>Ja</span></label>/<label><input type="radio" name="d[alle_reparaties]" value="nee" <%= d.alle_reparaties === 'nee' ? 'checked' : '' %>><span>Nee</span></label>
          </span>
        </div>

        <div class="cell"><span class="lbl">Km-stand (teller)</span><%- inp('km_uit', d.km_uit, 'inputmode="numeric"') %><span class="lbl">(uit)</span></div>
        <div class="cell"><span class="lbl">Contact opnemen bij extra kosten boven €</span><%- inp('contact_boven', d.contact_boven, 'inputmode="decimal"') %></div>

        <div class="cell"><span class="lbl">Datum deel I</span><%- inp('datum_deel1', d.datum_deel1, 'type="date"') %></div>
        <div class="cell"><span class="lbl">Chassisnummer</span><%- inp('chassisnummer', d.chassisnummer, 'class="ink upper"') %></div>

        <div class="cell"><span class="lbl">APK-datum</span><%- inp('apk_datum', d.apk_datum, 'type="date"') %></div>
        <div class="cell"><span class="lbl">Alarmcode</span><%- inp('alarmcode', d.alarmcode) %></div>
      </div>

      <div class="work">
        <div class="work-row work-head">
          <div class="w-check">✓</div><div class="w-oms">Omschrijving werkzaamheden</div><div class="w-code">Code</div><div class="w-tijd">Tijd</div>
        </div>
        <div class="work-row">
          <div class="w-check"></div>
          <div class="w-oms labelled"><span class="lbl">Servicebeurt</span><%- inp('servicebeurt_km', d.servicebeurt_km, 'class="ink right" inputmode="numeric"') %><span class="lbl">km</span><span class="spacer"></span></div>
          <div class="w-code"></div><div class="w-tijd"></div>
        </div>
        <div class="work-lines" data-sync>
          <div class="w-check"><%- lined('werk_check', 'aria-label="Afgevinkt"') %></div>
          <div class="w-oms"><%- lined('werk_omschrijving', 'aria-label="Omschrijving werkzaamheden"') %></div>
          <div class="w-code"><%- lined('werk_code', 'aria-label="Code"') %></div>
          <div class="w-tijd"><%- lined('werk_tijd', 'aria-label="Tijd"') %></div>
        </div>
        <div class="work-row foot">
          <div class="w-span labelled"><span class="lbl">Factuurnummer</span><%- inp('faktuurnr', d.faktuurnr) %></div>
        </div>
        <div class="work-row foot">
          <div class="w-span2 labelled"><span class="lbl">Totaal gewerkte uren</span><%- inp('totaal_uren', d.totaal_uren, 'inputmode="decimal"') %></div>
          <div class="w-code labelled stacked"><span class="lbl tiny">Tarief</span><%- inp('tarief', d.tarief, 'class="ink right" inputmode="decimal"') %></div>
          <div class="w-tijd labelled stacked"><span class="lbl tiny">Bedrag</span><%- inp('bedrag', d.bedrag, 'class="ink right" inputmode="decimal"') %></div>
        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- ===================== ACHTERKANT ===================== -->
  <h2 class="side-title no-print" id="achterkant">Achterkant</h2>
  <div class="sheet-scroll">
  <%- include('/partials/order-back', { d, nummer }) %>
  </div>

  <%# Extra bladen (vervolgblad voorkant/achterkant of een leeg blad) %>
  <div data-pages>
  <% (d.paginas || []).forEach((pg, i) => { %><%- include('/partials/order-page', { pg, i, nummer, editable }) %><% }) %>
  </div>
  <% if (editable) { %>
  <div class="page-add no-print" data-page-add data-max="<%= MAX_PAGES %>">
    <span class="muted">Blad toevoegen:</span>
    <button type="button" class="btn btn-small" data-add-page="voor">+ Voorkant</button>
    <button type="button" class="btn btn-small" data-add-page="achter">+ Achterkant</button>
    <button type="button" class="btn btn-small" data-add-page="blanco">+ Leeg blad</button>
  </div>
  <% } %>

  </fieldset>
</form>
<% if (editable) { for (const t of Object.keys(PAGE_TYPES)) { %>
<template data-page-tpl="<%= t %>"><%- include('/partials/order-page', { pg: emptyPage(t), i: '__I__', nummer, editable }) %></template>
<% } } %>

<%# Foto's bij de werkopdracht (buiten het formulier: de verwijderknoppen zijn eigen formulieren) %>
<% if (!draft) { %>
<div class="order-photos no-print">
  <%- include('/partials/photos', { photoList, photoOwner: order ? { type: 'order', id: order.id } : null, photoHint: 'Na het opslaan kunt u hier foto\'s toevoegen (schade, onderdelen, het dashboard of de km-stand).' }) %>
</div>
<% } %>
  <div class="form-actions no-print">
    <% if (draft) { %>
      <button class="btn btn-danger" type="submit" form="cancelImportForm">Annuleren</button>
      <button class="btn btn-primary" type="submit" form="orderForm">Bevestigen en opslaan</button>
      <% if (user.can_invoice) { %><button class="btn btn-ok" type="submit" form="orderForm" name="next_status" value="gefactureerd">Bevestigen als gefactureerd</button><% } %>
    <% } else { %>
      <%- include('/partials/order-actions', { where: 'bottom' }) %>
    <% } %>
  </div>

<% if (order && history.length) { %>
<details class="order-history no-print">
  <summary>Geschiedenis</summary>
  <ul>
    <% for (const h of history) { %><li><span class="muted"><%= fmtDateTime(h.created_at) %></span> – <%= h.user_name || 'onbekend' %>: <%= h.action %></li><% } %>
  </ul>
</details>
<% } %>

<% if (order && user.is_admin) { %>
<form method="post" action="/werkopdracht/<%= order.id %>/verwijderen" class="delete-form no-print"
      data-confirm="Werkopdracht <%= order.nummer %> definitief verwijderen? Dit kan niet ongedaan worden gemaakt.">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <button class="btn btn-danger btn-small" type="submit">Werkopdracht verwijderen</button>
</form>
<% } %>

<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<script src="/static/js/ai.js?v=<%= assetVersion %>"></script>
