<%- include('/partials/head') %>
<main class="page wide">
  <div class="page-head">
    <h1>Voorraad</h1>
    <form class="search" method="get" action="/voorraad" role="search" autocomplete="off">
      <input type="hidden" name="soort" value="<%= soort %>">
      <% if (type) { %><input type="hidden" name="type" value="<%= type %>"><% } %>
      <% if (locatie) { %><input type="hidden" name="locatie" value="<%= locatie %>"><% } %>
      <% if (alleen) { %><input type="hidden" name="alleen" value="1"><% } %>
      <input type="search" name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" data-1p-ignore data-lpignore="true" value="<%= q %>"
             placeholder="<%= soort === 'band' ? 'Zoek op maat (205/55R16 of 2055516), merk, type…' : 'Zoek op (OE-)nummer, merk, soort, auto… (spaties en punten maken niet uit)' %>" data-autofocus>
      <button class="btn" type="submit">Zoeken</button>
      <% if (q) { %><a class="btn btn-ghost" href="/voorraad?soort=<%= soort %>">Wissen</a><% } %>
    </form>
    <div class="head-buttons">
      <% if (feat.ai) { %><a class="btn" href="/lijsten/optimaliseren?lijst=<%= soort === 'band' ? 'voorraadbanden' : 'onderdelen' %>" title="Schrijfwijze, merken, soorten en maten laten nakijken door Claude"><%- include('/partials/ai-icon') %> Opschonen</a><% } %>
      <a class="btn btn-primary" href="/voorraad/nieuw?soort=<%= soort %>">+ <%= soort === 'band' ? 'Band' : 'Onderdeel' %> toevoegen</a>
    </div>
  </div>
  <%
    const qs = (o) => {
      const p = { soort, q, type, locatie, alleen, ...o };
      const parts = ['soort=' + p.soort];
      if (p.q) parts.push('q=' + encodeURIComponent(p.q));
      if (p.type) parts.push('type=' + encodeURIComponent(p.type));
      if (p.locatie) parts.push('locatie=' + encodeURIComponent(p.locatie));
      if (p.alleen) parts.push('alleen=1');
      return '/voorraad?' + parts.join('&');
    };
  %>
  <div id="live-stock" data-live>
  <div class="filter-bar">
    <nav class="status-tabs" aria-label="Soort voorraad">
      <% for (const [k, label] of Object.entries(SOORTEN)) { %>
        <a href="<%= qs({ soort: k, type: '', locatie: '' }) %>" class="<%= soort === k ? 'active' : '' %>"><%= label %><span class="count"><%= counts[k] %></span></a>
      <% } %>
    </nav>
    <form method="get" action="/voorraad" class="filter-selects">
      <input type="hidden" name="soort" value="<%= soort %>">
      <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
      <select name="type" aria-label="<%= soort === 'band' ? 'Seizoen' : 'Soort onderdeel' %>" data-autosubmit>
        <option value=""><%= soort === 'band' ? 'Alle seizoenen' : 'Alle soorten' %></option>
        <% for (const t of types) { %><option value="<%= t %>" <%= t.toLowerCase() === type.toLowerCase() ? 'selected' : '' %>><%= t %></option><% } %>
      </select>
      <select name="locatie" aria-label="Locatie" data-autosubmit>
        <option value="">Alle locaties</option>
        <% for (const l of locaties) { %><option value="<%= l %>" <%= l.toLowerCase() === locatie.toLowerCase() ? 'selected' : '' %>><%= l %></option><% } %>
      </select>
      <label class="check"><input type="checkbox" name="alleen" value="1" <%= alleen ? 'checked' : '' %> data-autosubmit> Alleen op voorraad</label>
      <noscript><button class="btn btn-small" type="submit">Filter</button></noscript>
    </form>
  </div>
  <% if (opslagMatches && feat.bandenhotel) { %><p class="opslag-hint">Ook <a href="/bandenhotel?soort=opslag&q=<%= encodeURIComponent(q) %>"><strong><%= opslagMatches %></strong> set<%= opslagMatches === 1 ? '' : 's' %> in de overige bandenopslag (noodbanden)</a> voor “<%= q %>”.</p><% } %>
  <% if (items.length === 0) { %>
    <div class="empty">
      <% if (!counts[soort]) { %>
        <p>Nog geen <%= soort === 'band' ? 'banden' : 'onderdelen' %> in de voorraad.</p>
        <p><a class="btn btn-primary" href="/voorraad/nieuw?soort=<%= soort %>">+ Toevoegen</a>
        <% if (user.is_admin) { %> of <a class="btn" href="/importeren/excel">Excel-lijst importeren</a><% } %></p>
      <% } else { %><p>Niets gevonden<%= q ? ' voor “' + q + '”' : '' %>.</p><% } %>
    </div>
  <% } else { %>
    <p class="muted"><%= items.length %> <%= soort === 'band' ? 'regel' + (items.length === 1 ? '' : 's') : 'onderde' + (items.length === 1 ? 'el' : 'len') %>
      · totaal <%= items.reduce((n, i) => n + i.aantal, 0) %> stuks</p>
    <div class="table-wrap">
    <table class="list clickable stock-list" data-csrf="<%= csrf %>">
      <thead><tr>
        <th class="ph-col"><span class="sr-only">Foto</span></th>
        <th class="qty-col">Aantal</th>
        <% if (soort === 'band') { %><th>Maat</th><th>Merk</th><th>Type</th><th>Profiel</th><th>Index</th><th>Seizoen</th>
        <% } else { %><th>Soort</th><th>Merk</th><th>Nummer</th><th>OE-nummer</th><th>Omschrijving</th><% } %>
        <th>Locatie</th>
      </tr></thead>
      <tbody>
      <% for (const i of items.slice(0, shownLimit)) { %>
        <tr data-href="/voorraad/<%= i.id %>" class="<%= !i.beschikbaar || i.aantal === 0 ? 'is-out' : '' %>">
          <% const ph = fotos.get(i.id); const sample = !ph && i.type ? partSamples[i.type] : null; %>
          <td class="ph-col"<%- sample === 'zoeken' ? ` data-parttype="${esc(i.type)}"` : '' %>><% if (ph) { %><a href="/fotos/<%= ph.id %>/full" data-photo-open class="ph-thumb"><img src="/fotos/<%= ph.id %>/thumb" alt="" loading="lazy"><% if (ph.n > 1) { %><span class="ph-n"><%= ph.n %></span><% } %></a><% } else if (sample && sample.ok) { %><span class="ph-thumb ph-sample" title="Voorbeeld: <%= sample.title %> (Wikipedia)"><img src="<%= sample.img %>" alt="" loading="lazy"></span><% } %></td>
          <td class="qty-col">
            <form method="post" action="/voorraad/<%= i.id %>/aantal" class="qty" data-qty>
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="qty-btn" type="submit" name="delta" value="-1" aria-label="Eén minder" <%= i.aantal === 0 ? 'disabled' : '' %>>−</button>
              <output class="qty-n" aria-live="polite"><%= i.aantal %></output>
              <button class="qty-btn" type="submit" name="delta" value="1" aria-label="Eén meer">+</button>
            </form>
          </td>
          <% if (soort === 'band') { %>
            <td class="maat-col"><strong><%= i.maat %></strong></td><td><%= i.merk %></td><td><%= i.type %></td><td><%= i.profiel %></td><td><%= i.snelheid %></td>
            <td><% if (i.seizoen) { %><span class="season season-<%= /^winter$/i.test(i.seizoen) ? 'winter' : /^zomer$/i.test(i.seizoen) ? 'zomer' : /all/i.test(i.seizoen) ? 'all' : 'mix' %>"><%- esc(i.seizoen).replace(/\//g, '/<wbr>') %></span><% } %></td>
          <% } else { %>
            <td><%= i.type %></td><td><%= i.merk %></td><td class="mono"><%= i.nummer %></td><td class="mono"><%= i.oe_nummer %></td><td class="summary" title="<%= i.omschrijving %>"><%= i.omschrijving %></td>
          <% } %>
          <td><%= i.locatie %><% if (!i.beschikbaar) { %> <span class="out-pill">niet beschikbaar</span><% } %></td>
        </tr>
      <% } %>
      </tbody>
    </table>
    </div>
    <%- include('/partials/more', { shown: Math.min(shownLimit, items.length), total: items.length }) %>
  <% } %>
  </div>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<script src="/static/js/photos.js?v=<%= assetVersion %>"></script>
<script src="/static/js/inventory.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
