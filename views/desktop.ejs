<%- include('/partials/head', { bodyClass: 'desktop-shell' }) %>
<%
  const ICONS = {
    ai: '<path d="M9 2.5v3M15 2.5v3M9 18.5v3M15 18.5v3M2.5 9h3M2.5 15h3M18.5 9h3M18.5 15h3"/><rect x="5.5" y="5.5" width="13" height="13" rx="3"/><path d="M8.6 15.2 10.4 9h.4l1.8 6.2M9.2 13.4h2.6M15 9v6.2"/>',
    calc: '<rect x="5" y="2.5" width="14" height="19" rx="2"/><rect x="8" y="5.5" width="8" height="4" rx=".8"/><path d="M8.5 13h.01M12 13h.01M15.5 13h.01M8.5 16.5h.01M12 16.5h.01M15.5 16.5h.01"/>',
    plus: '<path d="M12 5v14M5 12h14"/>',
    folder: '<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2h8.5A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z"/>',
    bin: '<path d="M4 7h16M9 7V4.5h6V7M6 7l1 13h10l1-13"/>',
    binfull: '<path d="M4 7h16M9 7V4.5h6V7M6 7l1 13h10l1-13"/><path d="M9.5 11.5l2 1.5-1 2.5M14 11l-1.5 3 2 1.5"/>',
    people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.6c2.6.2 4.6 1.9 5.3 4.9"/>',
    list: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
    euro: '<path d="M17 6.5A6.5 6.5 0 1 0 17 17.5M5 10.5h9M5 13.5h9"/>',
    tyre: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5"/><path d="M12 3.5v5M12 15.5v5M3.5 12h5M15.5 12h5"/>',
    swap: '<path d="M7 7h11l-3-3M17 17H6l3 3"/>',
    calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4M8 14.5l2.5 2.5 5-5"/>',
    box: '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
    camera: '<path d="M4 8h3l2-2.5h6L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
    gear: '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/>',
    globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
    grid: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
    help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.6 2.6 0 0 1 5 1c0 1.8-2.5 2.2-2.5 4"/><circle cx="12" cy="17.5" r=".6" fill="currentColor"/>',
  };
  const F = locals.feat || {};
  const NEW_ICON = { '/werkopdracht/nieuw': 'plus', '/bandenhotel/nieuw': 'tyre', '/voorraad/nieuw': 'box' };
  const apps = [{ href: '/', icon: 'people', title: 'Klanten' }];
  if (F.werkopdrachten) apps.push({ href: '/werkopdrachten', icon: 'list', title: 'Werkopdrachten' });
  if (user.can_invoice && F.werkopdrachten) apps.push({ href: '/werkopdrachten?status=klaar', icon: 'euro', title: 'Facturatie' });
  if (F.apk) apps.push({ href: '/apk', icon: 'calendar', title: 'APK-lijst' });
  if (F.bandenhotel) apps.push({ href: '/bandenhotel', icon: 'tyre', title: 'Bandenhotel' }, { href: '/bandenhotel/wissellijst', icon: 'swap', title: 'Wissellijst' });
  if (F.voorraad) apps.push({ href: '/voorraad', icon: 'box', title: 'Voorraad' });
  if (F.portaal) apps.push({ href: '/portaal', icon: 'grid', title: 'Portaal' });
  if (F.rekenhulp) apps.push({ href: '/rekenhulp', icon: 'calc', title: 'Rekenhulp' });
  if (aiOn && F.ai) apps.push({ href: '/ai-analyse', icon: 'ai', title: 'AI-analyse' });
  if (importOn && F.werkopdrachten) apps.push({ href: '/importeren', icon: 'camera', title: 'Importeren' });
  else if (user.is_admin && (F.bandenhotel || F.voorraad)) apps.push({ href: '/importeren/excel', icon: 'camera', title: 'Importeren' });
  apps.push({ href: '/verkenner', icon: 'folder', title: 'Verkenner' }, { href: 'internet', icon: 'globe', title: 'Internet' });
  apps.push({ href: '/start', icon: 'grid', title: 'Startscherm' }, { href: '/hulp', icon: 'help', title: 'Hulp' });
  if (user.is_admin) apps.push({ href: '/prullenbak', icon: locals.trashCount ? 'binfull' : 'bin', title: 'Prullenbak' });
  const svg = (k, s = 30) => `<svg viewBox="0 0 24 24" width="${s}" height="${s}" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICONS[k] || ICONS.grid}</svg>`;
%>
<main class="dt" data-desktop data-user="<%= user.id %>" aria-label="Bureaublad">
  <ul class="dt-icons" role="list">
    <% if (locals.newAction) { %><li><button type="button" class="dt-icon dt-icon-new" data-open="<%= newAction.href %>" data-icon="<%= NEW_ICON[newAction.href] %>"><span class="dt-icon-img"><%- svg(NEW_ICON[newAction.href]) %></span><span class="dt-icon-name"><%= newAction.long %></span></button></li><% } %>
    <% for (const a of apps) { %>
    <li><button type="button" class="dt-icon" data-open="<%= a.href %>" data-icon="<%= a.icon %>"><span class="dt-icon-img"><%- svg(a.icon) %></span><span class="dt-icon-name"><%= a.title %></span></button></li>
    <% } %>
  </ul>
  <div class="dt-windows" data-windows></div>
  <p class="dt-hint muted small" data-hint>Dubbelklik op een pictogram om een venster te openen. Ctrl+klik op een link in een venster opent een nieuw venster.</p>
</main>
<template id="dt-icon-svgs"><% for (const k of Object.keys(ICONS)) { %><span data-k="<%= k %>"><%- svg(k, 16) %></span><% } %></template>

<nav class="dt-taskbar no-print" aria-label="Taakbalk">
  <button type="button" class="dt-start" data-start aria-haspopup="menu" aria-expanded="false"><%- include('/partials/logo') %></button>
  <div class="dt-tasks" data-tasks role="toolbar" aria-label="Open vensters"></div>
  <span class="dt-clock" data-clock></span>
  <button type="button" class="dt-showdesk" data-showdesk title="Bureaublad weergeven" aria-label="Bureaublad weergeven"></button>
</nav>
<div class="dt-menu no-print" data-menu role="menu" hidden>
  <div class="dt-menu-head"><b><%= user.name %></b><span class="muted small">ADONIS v<%= locals.appInfo ? appInfo.version : '' %></span></div>
  <% if (locals.newAction) { %><button type="button" role="menuitem" class="dt-menu-item dt-menu-new" data-open="<%= newAction.href %>" data-icon="<%= NEW_ICON[newAction.href] %>"><%- svg(NEW_ICON[newAction.href], 18) %> <%= newAction.long %></button><% } %>
  <% for (const a of apps) { %><button type="button" role="menuitem" class="dt-menu-item" data-open="<%= a.href %>" data-icon="<%= a.icon %>"><%- svg(a.icon, 18) %> <%= a.title %></button><% } %>
  <div class="dt-menu-sep"></div>
  <button type="button" role="menuitem" class="dt-menu-item" data-open="/instellingen" data-icon="gear"><%- svg('gear', 18) %> Instellingen</button>
  <% if (user.is_admin) { %><button type="button" role="menuitem" class="dt-menu-item" data-open="/gebruikers" data-icon="people"><%- svg('people', 18) %> Gebruikers</button><% } %>
  <% if (user.is_owner) { %><button type="button" role="menuitem" class="dt-menu-item" data-open="/systeem" data-icon="gear"><%- svg('gear', 18) %> Systeem</button><% } %>
  <button type="button" role="menuitem" class="dt-menu-item" data-arrange>Vensters schikken</button>
  <button type="button" role="menuitem" class="dt-menu-item" data-closeall>Alle vensters sluiten</button>
  <a role="menuitem" class="dt-menu-item" href="/start?klassiek=1" title="Terug naar de gewone weergave, zonder vensters">Gewone weergave</a>
  <form method="post" action="/logout" class="dt-menu-item-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" role="menuitem" class="dt-menu-item">Uitloggen</button></form>
</div>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<script src="/static/js/desktop.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
