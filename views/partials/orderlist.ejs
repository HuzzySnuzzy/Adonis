<div class="table-wrap">
<table class="list clickable">
  <thead><tr>
    <th class="num">Nr.</th><th>Status</th><th>Datum</th><% if (showPlate) { %><th>Kenteken</th><th>Naam</th><% } %>
    <th>Km-stand</th><th>Monteur</th><th>Werkzaamheden</th>
  </tr></thead>
  <tbody>
  <% const noteCounts = locals.user ? notesOnOrders(user) : new Map(); %>
  <% for (const o of orders) { %>
    <tr data-href="/werkopdracht/<%= o.id %>">
      <% const nNotes = noteCounts.get(o.id) || 0; %>
      <td class="num"><a class="ordernr" href="/werkopdracht/<%= o.id %>"><%= o.nummer %></a><% if (nNotes) { %> <span class="note-flag" title="<%= nNotes %> plaknotitie<%= nNotes === 1 ? '' : 's' %> op deze werkopdracht" aria-label="<%= nNotes %> plaknotities"></span><% } %></td>
      <td><span class="status-badge status-<%= o.status %> in-list"><%= { open: 'Open', klaar: 'Facturatie', gefactureerd: 'Gefactureerd' }[o.status] || o.status %></span></td>
      <td><%= fmtDate(o.datum_invoer) %></td>
      <% if (showPlate) { %><td><%- include('/partials/plate', { kenteken: o.d.kenteken || o.c_kenteken }) %></td><td><%= o.d.naam %></td><% } %>
      <td><%= o.d.km_in || o.d.km_uit %></td>
      <td><%= o.d.monteur %></td>
      <td class="summary"><%= o.summary %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
