<div class="table-wrap">
<table class="list clickable">
  <thead><tr>
    <th class="num">Nr.</th><th>Datum</th><% if (showPlate) { %><th>Kenteken</th><th>Naam</th><% } %>
    <th>Km-stand</th><th>Monteur</th><th>Werkzaamheden</th>
  </tr></thead>
  <tbody>
  <% for (const o of orders) { %>
    <tr data-href="/werkopdracht/<%= o.id %>">
      <td class="num"><a class="ordernr" href="/werkopdracht/<%= o.id %>"><%= o.nummer %></a></td>
      <td><%= fmtDate(o.datum_invoer) %></td>
      <% if (showPlate) { %><td><%- include('plate', { kenteken: o.d.kenteken || o.c_kenteken }) %></td><td><%= o.d.naam %></td><% } %>
      <td><%= o.d.km_in || o.d.km_uit %></td>
      <td><%= o.d.monteur %></td>
      <td class="summary"><%= o.summary %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
