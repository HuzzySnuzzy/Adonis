<%# Aandachtspunten van Claude voor deze auto, als inklapbaar vak. Verwacht: bl (forCustomer), aiOn, customer, compact (op de werkopdracht) %>
<% const L = { laag: 'Snel', normaal: 'Normaal', hoog: 'Grondig' };
   const compactView = locals.compact;
   const high = bl.open.filter((b) => b.ernst === 'hoog').length; %>
<% if (bl.open.length || bl.analysis || (aiOn && !compactView)) { %>
<details class="card bl-box<%= high ? ' has-high' : '' %><%= compactView ? ' no-print' : '' %>" id="aandachtspunten" data-remember="bl-klant">
  <summary class="bl-summary">
    <span class="bl-sum-title">Aandachtspunten</span>
    <% if (bl.open.length) { %><span class="nav-count<%= high ? ' is-high' : '' %>" title="<%= high ? high + ' belangrijk' : '' %>"><%= bl.open.length %></span><% } %>
    <span class="bl-sum-preview muted small">
      <% if (bl.open.length) { %><%= bl.open[0].titel %><%= bl.open.length > 1 ? ' + ' + (bl.open.length - 1) + ' meer' : '' %>
      <% } else if (bl.analysis) { %>niets bijzonders<% } else { %>nog niet geanalyseerd<% } %>
      <% if (bl.stale && !compactView) { %> · <b class="bl-stale">verouderd</b><% } %>
    </span>
  </summary>
  <div class="bl-body">
    <div class="bl-toolbar">
      <% if (compactView) { %><p class="muted small">Uit de werkopdrachten van deze auto (Claude).</p><a class="small" href="/klant/<%= customer.id %>#aandachtspunten">Bij de klant bekijken</a>
      <% } else { %>
      <p class="muted small bl-meta">
        <% if (bl.analysis) { %>Door Claude uit <%= bl.analysis.n_orders %> werkopdracht<%= bl.analysis.n_orders === 1 ? '' : 'en' %> gehaald op <%= fmtDateTime(bl.analysis.analyzed_at) %>
          (<%= L[bl.analysis.effort] || bl.analysis.effort %><%= bl.analysis.by_name ? ', ' + bl.analysis.by_name : '' %>).
          <% if (bl.stale) { %><b class="bl-stale">Er zijn werkopdrachten bijgekomen of gewijzigd sinds de analyse.</b><% } %>
        <% } else { %>Claude leest alle werkopdrachten van deze auto en zet hier alleen wat de monteurs echt moeten weten bij een volgend bezoek
          (tijdelijke oplossingen, geadviseerd maar niet gedaan, slijtage, gewijzigde codering…). U ziet vooraf wat het kost.<% } %>
      </p>
      <% if (aiOn) { %>
      <button class="btn btn-small<%= !bl.analysis || bl.stale ? ' btn-primary' : '' %>" type="button" data-ai-task="klant" data-ai-id="<%= customer.id %>"
        data-ai-action="/klant/<%= customer.id %>/aandachtspunten" data-ai-anchor="aandachtspunten" data-ai-title="Werkopdrachten laten doorlezen door Claude"><%- include('/partials/ai-icon') %> <%= bl.analysis ? 'Opnieuw analyseren' : 'Analyseren met Claude' %></button>
      <% } else if (locals.aiLocked) { %><span class="muted small ai-locked" title="AI-functies kosten geld; een beheerder bepaalt wie ze mag starten">Geen AI-toegang – vraag een beheerder</span>
      <% } %>
      <% } %>
    </div>
    <% if (bl.open.length) { %>
    <div class="bl-list">
      <% for (const b of bl.open) { %>
      <details class="bl-item bl-<%= b.ernst %>">
        <summary><span class="bl-dot" aria-hidden="true"></span><b class="bl-title"><%= b.titel %></b>
          <span class="muted small bl-when"><%= b.order_nummer ? 'werkopdracht ' + b.order_nummer : '' %><%= b.datum ? ' · ' + fmtDate(b.datum) : '' %></span></summary>
        <div class="bl-detail">
          <% if (b.tekst) { %><p><%= b.tekst %></p><% } %>
          <% if (b.actie) { %><p><b>Doen:</b> <%= b.actie %></p><% } %>
          <form method="post" action="/aandachtspunt/<%= b.id %>/afgehandeld" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-small" type="submit" title="Gecontroleerd of opgelost: van de lijst halen">Afgehandeld</button>
          </form>
        </div>
      </details>
      <% } %>
    </div>
    <% } else if (bl.analysis && !compactView) { %>
    <p class="bl-none">Niets dat extra aandacht nodig heeft.</p>
    <% } %>
    <% if (bl.done.length && !compactView) { %>
    <details class="bl-done"><summary class="muted small">Afgehandeld (<%= bl.done.length %>)</summary>
      <div class="bl-list">
        <% for (const b of bl.done) { %>
        <div class="bl-item is-done"><span class="bl-title"><%= b.titel %></span><span class="muted small">afgehandeld <%= fmtDate(b.done_at.slice(0, 10)) %></span>
          <form method="post" action="/aandachtspunt/<%= b.id %>/afgehandeld" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-small btn-ghost" type="submit">Terugzetten</button></form></div>
        <% } %>
      </div>
    </details>
    <% } %>
  </div>
</details>
<% } %>
