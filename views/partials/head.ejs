<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Werkopdrachten</title>
  <link rel="stylesheet" href="/static/css/app.css">
  <% if (typeof extraCss !== 'undefined') { %><link rel="stylesheet" href="/static/css/<%= extraCss %>"><% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<% if (locals.user) { %>
<header class="topbar no-print">
  <a class="brand" href="/">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>
    Werkopdrachten
  </a>
  <nav class="mainnav">
    <a href="/" class="<%= path === '/' || path.startsWith('/klant') ? 'active' : '' %>">Klanten</a>
    <a href="/werkopdrachten" class="<%= path === '/werkopdrachten' ? 'active' : '' %>">Alle werkopdrachten</a>
    <% if (user.is_admin) { %><a href="/gebruikers" class="<%= path === '/gebruikers' ? 'active' : '' %>">Gebruikers</a><% } %>
  </nav>
  <div class="usernav">
    <a class="btn btn-primary" href="/werkopdracht/nieuw">+ Nieuwe werkopdracht</a>
    <a href="/account" class="username" title="Mijn account"><%= user.name %></a>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="linkbtn" type="submit">Uitloggen</button>
    </form>
  </div>
</header>
<% } %>
<% if (locals.flash) { %>
<div class="flash flash-<%= flash.type %> no-print" role="status"><%= flash.text %></div>
<% } %>
