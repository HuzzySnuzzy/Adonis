<%
  const prefs = locals.prefs || { theme: 'system', ink: 'hand' };
  const themeAttr = prefs.theme === 'system' ? '' : ` data-theme="${prefs.theme}"`;
  const THEME_LABEL = { system: 'Systeem', light: 'Licht', dark: 'Donker', neon: 'Neon', ice: 'Black Ice' };
  const NEXT_THEME = { system: 'light', light: 'dark', dark: 'neon', neon: 'ice', ice: 'system' };
%>
<!doctype html>
<html lang="nl"<%- themeAttr %> data-ink="<%= prefs.ink %>" data-fx="<%= prefs.fx || 'full' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="<%= prefs.theme === 'system' ? 'light dark' : ['neon', 'ice'].includes(prefs.theme) ? 'dark' : prefs.theme %>">
  <meta name="theme-color" content="<%= prefs.theme === 'neon' ? '#07090c' : prefs.theme === 'ice' ? '#03060c' : '#14171c' %>">
  <title><%= title %> · ADONIS</title>
  <link rel="icon" type="image/svg+xml" href="/static/img/adonis-icon.svg">
  <link rel="apple-touch-icon" href="/static/img/adonis-icon.svg">
  <script src="/static/js/early.js?v=<%= assetVersion %>"></script>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= assetVersion %>">
  <% if (typeof extraCss !== 'undefined') { %><link rel="stylesheet" href="/static/css/<%= extraCss %>?v=<%= assetVersion %>"><% } %>
  <script src="/static/js/theme-menu.js?v=<%= assetVersion %>" defer></script>
  <% if (prefs.theme === 'neon') { %>
  <link rel="preload" href="/static/fonts/orbitron-latin-wght-v1.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/oxanium-latin-wght-v1.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/share-tech-mono-latin-400-v1.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/theme-neon.css?v=<%= assetVersion %>">
  <script src="/static/js/neon.js?v=<%= assetVersion %>" defer></script>
  <% } %>
  <% if (prefs.theme === 'ice') { %>
  <link rel="preload" href="/static/fonts/michroma-latin-400-v1.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fonts/exo2-latin-wght-v1.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/theme-ice.css?v=<%= assetVersion %>">
  <script src="/static/js/ice.js?v=<%= assetVersion %>" defer></script>
  <% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<% if (locals.user) { %> data-user-id="<%= user.id %>"<%- user.can_invoice ? ' data-can-invoice="1"' : '' %><% } %>>
<% if (prefs.theme === 'ice') { %>
<div class="ice-field no-print" aria-hidden="true"><i class="ice-aurora"></i><i class="ice-aurora"></i><i class="ice-aurora"></i><i class="ice-core"></i><i class="ice-glint"></i></div>
<% } %>
<% if (prefs.theme === 'neon') { %>
<div class="liquid no-print" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
<% if (locals.user) { %>
<div class="hud-rail hud-rail-l no-print" aria-hidden="true"><b>ADONIS//2049</b><span>WERKPLAATS 07-K</span><span>SECTOR 52.37N</span><span data-hud-clock>T --:--:--</span></div>
<div class="hud-rail hud-rail-r no-print" aria-hidden="true"><i class="hud-rail-mark"></i><span data-hud-depth>DIEPTE 000</span><span>SIG NOMINAAL</span></div>
<% } %>
<% } %>
<% if (locals.user) { %>
<header class="topbar no-print">
  <a class="brand" href="/" title="ADONIS – naar het overzicht"><%- include('/partials/logo') %></a>
  <nav class="mainnav">
    <a href="/" class="<%= path === '/' || path.startsWith('/klant') ? 'active' : '' %>">Klanten</a>
    <a href="/werkopdrachten" class="<%= (path === '/werkopdrachten' && !(locals.url || '').includes('status=klaar')) || path.startsWith('/werkopdracht/') ? 'active' : '' %>">Werkopdrachten</a>
    <% if (user.can_invoice) { %><a href="/werkopdrachten?status=klaar" class="<%= path === '/werkopdrachten' && locals.url && locals.url.includes('status=klaar') ? 'active' : '' %>">Facturatie<span id="live-nav-count" data-live><% if (locals.invoiceCount) { %><span class="nav-count" title="Klaar om te factureren"><%= invoiceCount %></span><% } %></span></a><% } %>
    <a href="/bandenhotel" class="<%= path.startsWith('/bandenhotel') ? 'active' : '' %>">Bandenhotel</a>
    <a href="/voorraad" class="<%= path.startsWith('/voorraad') ? 'active' : '' %>">Voorraad</a>
    <a href="/importeren" class="<%= path.startsWith('/importeren') ? 'active' : '' %>">Importeren</a>
    <% if (user.is_admin) { %><a href="/gebruikers" class="<%= path === '/gebruikers' ? 'active' : '' %>">Gebruikers</a><% } %>
    <% if (user.is_owner) { %><a href="/systeem" class="<%= path === '/systeem' ? 'active' : '' %>">Systeem</a><% } %>
  </nav>
  <div class="usernav">
    <a class="btn btn-primary" href="/werkopdracht/nieuw">+ Nieuwe werkopdracht</a>
    <%
      const THEMES_MENU = [
        { v: 'system', name: 'Systeem', sub: 'Volgt de instelling van je apparaat' },
        { v: 'light', name: 'Licht', sub: 'Helder en rustig' },
        { v: 'dark', name: 'Donker', sub: 'Gedimd, prettig in een donkere werkplaats' },
        { v: 'neon', name: 'Neon', sub: 'Amberkleurige nevel, hologrammen en regen' },
        { v: 'ice', name: 'Black Ice', sub: 'ICE·XVIII: zwart kristalrooster, ionensporen en rijp' },
      ];
      const fxNow = prefs.fx || 'full';
    %>
    <div class="theme-wrap">
      <%# Zonder JavaScript wisselt de knop gewoon naar het volgende thema (formulier). %>
      <form method="post" action="/instellingen/thema" class="inline" id="themeForm">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="next" value="<%= locals.url || '/' %>">
        <button class="iconbtn theme-btn" type="submit" id="themeBtn"
                title="Thema: <%= THEME_LABEL[prefs.theme] %>" aria-label="Thema kiezen (nu <%= THEME_LABEL[prefs.theme] %>)"
                aria-haspopup="menu" aria-expanded="false" aria-controls="themeMenu">
          <svg class="ti ti-system" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="ti ti-light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
          <svg class="ti ti-dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg>
          <svg class="ti ti-ice" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 2.5v19M3.8 7.25l16.4 9.5M3.8 16.75l16.4-9.5M12 2.5 9.6 5M12 2.5 14.4 5M12 21.5 9.6 19M12 21.5l2.4-2.5"/></g><path fill="currentColor" d="m12 9.2 2.4 1.4v2.8L12 14.8l-2.4-1.4v-2.8z"/></svg>
          <svg class="ti ti-neon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M12 2 21 7v10l-9 5-9-5V7z"/><path fill="currentColor" d="M13 6 8 13h3.5L10.5 18 16 10.5h-3.5z"/></svg>
        </button>
      </form>
      <div id="themeMenu" class="theme-menu" role="menu" aria-label="Thema" hidden data-csrf="<%= csrf %>">
        <% for (const t of THEMES_MENU) { %>
        <button type="button" role="menuitemradio" class="theme-item" data-theme-value="<%= t.v %>" aria-checked="<%= prefs.theme === t.v %>" tabindex="-1">
          <span class="theme-swatch sw-<%= t.v %>" aria-hidden="true"></span><span class="theme-name<%= t.v === 'neon' ? ' theme-name-neon' : t.v === 'ice' ? ' theme-name-ice' : '' %>"><%= t.name %></span>
          <span class="theme-sub"><%= t.sub %></span>
        </button>
        <% } %>
        <div class="theme-sep" role="separator"></div>
        <div class="theme-fx" role="group" aria-labelledby="themeFxLabel">
          <span class="theme-fx-label" id="themeFxLabel">Effecten (Neon, Black Ice)</span>
          <button type="button" role="menuitemradio" class="theme-fx-item" data-fx-value="full" aria-checked="<%= fxNow === 'full' %>" tabindex="-1">
            <span class="theme-name">Volledig</span><span class="theme-sub">Opstartreeks en alle animaties</span></button>
          <button type="button" role="menuitemradio" class="theme-fx-item" data-fx-value="calm" aria-checked="<%= fxNow === 'calm' %>" tabindex="-1">
            <span class="theme-name">Rustig</span><span class="theme-sub">Minder beweging, fijn op oudere pc's</span></button>
          <p class="theme-fx-note" id="themeFxNote" hidden>Je apparaat vraagt om minder beweging</p>
        </div>
      </div>
    </div>
    <a href="/instellingen" class="username" title="Instellingen"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M19.4 13a7.6 7.6 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.7 7.7 0 0 0-1.7-1L15 3.3h-4l-.4 2.6a7.7 7.7 0 0 0-1.7 1l-2.5-1-2 3.5L6.6 11a7.6 7.6 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1a7.7 7.7 0 0 0 1.7 1l.4 2.6h4l.4-2.6a7.7 7.7 0 0 0 1.7-1l2.5 1 2-3.5zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" transform="translate(-1 0)"/></svg><span class="uname"><%= user.name %></span></a>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="linkbtn" type="submit">Uitloggen</button>
    </form>
  </div>
</header>
<% } %>
<% if (locals.flash) { %>
<div class="flash flash-<%= flash.type %> no-print" role="status"><%= flash.text %></div>
<% } %>
