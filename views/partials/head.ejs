<%
  const prefs = locals.prefs || { theme: 'system', ink: 'hand' };
  const themeAttr = prefs.theme === 'system' ? '' : ` data-theme="${prefs.theme}"`;
  const THEME_LABEL = { system: 'Systeem', light: 'Licht', dark: 'Donker', neon: 'Neon' };
  const NEXT_THEME = { system: 'light', light: 'dark', dark: 'neon', neon: 'system' };
%>
<!doctype html>
<html lang="nl"<%- themeAttr %> data-ink="<%= prefs.ink %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="<%= prefs.theme === 'system' ? 'light dark' : prefs.theme === 'neon' ? 'dark' : prefs.theme %>">
  <meta name="theme-color" content="<%= prefs.theme === 'neon' ? '#07090c' : '#14171c' %>">
  <title><%= title %> · ADONIS</title>
  <link rel="icon" type="image/svg+xml" href="/static/img/adonis-icon.svg">
  <link rel="apple-touch-icon" href="/static/img/adonis-icon.svg">
  <script src="/static/js/early.js?v=<%= assetVersion %>"></script>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= assetVersion %>">
  <% if (typeof extraCss !== 'undefined') { %><link rel="stylesheet" href="/static/css/<%= extraCss %>?v=<%= assetVersion %>"><% } %>
  <% if (prefs.theme === 'neon') { %><link rel="stylesheet" href="/static/css/theme-neon.css?v=<%= assetVersion %>"><% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>"<% if (locals.user) { %> data-user-id="<%= user.id %>"<%- user.can_invoice ? ' data-can-invoice="1"' : '' %><% } %>>
<% if (prefs.theme === 'neon') { %>
<div class="neon-bg no-print" aria-hidden="true">
  <span class="orb orb-1"></span><span class="orb orb-2"></span><span class="orb orb-3"></span><span class="orb orb-4"></span>
  <span class="holo-grid"></span><span class="dust dust-1"></span><span class="dust dust-2"></span>
  <span class="shimmer"></span><span class="fog"></span><span class="rain rain-1"></span><span class="rain rain-2"></span>
  <span class="hud hud-left">ADONIS // WERKPLAATS-07 // SEC 4·12·88 // LINK STABIEL</span>
  <span class="hud hud-right">DIEPTE 880 // SIG NOMINAAL // KANAAL 2049</span>
</div>
<% } %>
<% if (locals.user) { %>
<header class="topbar no-print">
  <a class="brand" href="/" title="ADONIS – naar het overzicht"><%- include('/partials/logo') %></a>
  <nav class="mainnav">
    <a href="/" class="<%= path === '/' || path.startsWith('/klant') ? 'active' : '' %>">Klanten</a>
    <a href="/werkopdrachten" class="<%= path === '/werkopdrachten' && !(locals.url || '').includes('status=klaar') ? 'active' : '' %>">Alle werkopdrachten</a>
    <% if (user.can_invoice) { %><a href="/werkopdrachten?status=klaar" class="<%= path === '/werkopdrachten' && locals.url && locals.url.includes('status=klaar') ? 'active' : '' %>">Facturatie<span id="live-nav-count" data-live><% if (locals.invoiceCount) { %><span class="nav-count" title="Klaar om te factureren"><%= invoiceCount %></span><% } %></span></a><% } %>
    <a href="/importeren" class="<%= path.startsWith('/importeren') ? 'active' : '' %>">Foto importeren</a>
    <% if (user.is_admin) { %><a href="/gebruikers" class="<%= path === '/gebruikers' ? 'active' : '' %>">Gebruikers</a><% } %>
    <% if (user.is_owner) { %><a href="/systeem" class="<%= path === '/systeem' ? 'active' : '' %>">Systeem</a><% } %>
  </nav>
  <div class="usernav">
    <a class="btn btn-primary" href="/werkopdracht/nieuw">+ Nieuwe werkopdracht</a>
    <form method="post" action="/instellingen/thema" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= locals.url || '/' %>">
      <button class="iconbtn" type="submit"
              title="Thema: <%= THEME_LABEL[prefs.theme] %> – klik voor <%= THEME_LABEL[NEXT_THEME[prefs.theme]] %>"
              aria-label="Thema wisselen (nu <%= THEME_LABEL[prefs.theme] %>)">
        <% if (prefs.theme === 'light') { %>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
        <% } else if (prefs.theme === 'neon') { %>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M12 2 21 7v10l-9 5-9-5V7z"/><path fill="currentColor" d="M13 6 8 13h3.5L10.5 18 16 10.5h-3.5z"/></svg>
        <% } else if (prefs.theme === 'dark') { %>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg>
        <% } else { %>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <% } %>
      </button>
    </form>
    <a href="/instellingen" class="username" title="Instellingen"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M19.4 13a7.6 7.6 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.7 7.7 0 0 0-1.7-1L15 3.3h-4l-.4 2.6a7.7 7.7 0 0 0-1.7 1l-2.5-1-2 3.5L6.6 11a7.6 7.6 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1a7.7 7.7 0 0 0 1.7 1l.4 2.6h4l.4-2.6a7.7 7.7 0 0 0 1.7-1l2.5 1 2-3.5zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" transform="translate(-1 0)"/></svg><span class="uname"><%= user.name %></span></a>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="linkbtn" type="submit">Uitloggen</button>
    </form>
  </div>
</header>
<% } %>
<% if (locals.flash) { %>
<div class="flash flash-<%= flash.type %> no-print" role="status"><%= flash.text %></div>
<% } %>
