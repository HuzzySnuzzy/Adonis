<%# Achterkant van de werkopdracht (indeling zoals het papieren formulier): aantekeningen/APK-advies, uren, banden, keuringen en leenauto.
    Verwacht: d (werkopdrachtgegevens), nummer, TIRES %>
<%
  const a = d.achter;
  const radio = (name, value, current, label) =>
    `<label class="cellbox" title="${label}"><input type="radio" name="d[achter]${name}" value="${value}" ${current === value ? 'checked' : ''} aria-label="${label}"><span></span></label>`;
  const check = (name, on, label) =>
    `<label class="box"><input type="checkbox" name="d[achter]${name}" ${on ? 'checked' : ''}> ${label}</label>`;
  const k = a.keuring; const l = a.leenauto;
  const WHEEL = { lv: 'Linksvoor', la: 'Linksachter', rv: 'Rechtsvoor', ra: 'Rechtsachter', reserve: 'Reservewiel' };
%>
<section class="sheet back back2" aria-label="Achterkant werkopdracht">
  <div class="panel panel-left">
    <div class="back-head"><span class="wo-title small-title">Aantekeningen van de werkplaats / APK-advies</span><span class="red-nr mirror-nr"><%= nummer %></span></div>
    <table class="grid advies" data-advies>
      <colgroup><col class="c-chk"><col><col class="c-opt"><col class="c-opt"><col class="c-opt"><col class="c-kost"><col class="c-opt"><col class="c-opt"><col class="c-opt"></colgroup>
      <thead><tr>
        <th class="center">✓</th><th>Omschrijving</th>
        <th class="center vert">garan&shy;tie</th><th class="center vert">nood&shy;zaak</th><th class="center vert">geen nood&shy;zaak</th>
        <th class="center small-th">kosten incl. montage en btw</th>
        <th class="center vert">uit&shy;voeren</th><th class="center vert">niet uit&shy;voeren</th><th class="center vert">nieuwe afspraak</th>
      </tr></thead>
      <tbody>
      <% a.advies.forEach((r, i) => { %>
        <tr data-line>
          <td class="center"><label class="cellbox"><input type="checkbox" name="d[achter][advies][<%= i %>][check]" <%= r.check ? 'checked' : '' %> aria-label="Afgevinkt"><span></span></label></td>
          <td><%- inp(`achter.advies.${i}.tekst`, r.tekst) %></td>
          <td class="center"><%- radio(`[advies][${i}][soort]`, 'garantie', r.soort, 'Garantie') %></td>
          <td class="center"><%- radio(`[advies][${i}][soort]`, 'noodzaak', r.soort, 'Noodzaak') %></td>
          <td class="center"><%- radio(`[advies][${i}][soort]`, 'geen', r.soort, 'Geen noodzaak') %></td>
          <td><%- inp(`achter.advies.${i}.kosten`, r.kosten, 'class="ink right" inputmode="decimal" data-advies-cost') %></td>
          <td class="center"><%- radio(`[advies][${i}][besluit]`, 'uitvoeren', r.besluit, 'Uitvoeren') %></td>
          <td class="center"><%- radio(`[advies][${i}][besluit]`, 'niet', r.besluit, 'Niet uitvoeren') %></td>
          <td class="center"><%- radio(`[advies][${i}][besluit]`, 'afspraak', r.besluit, 'Nieuwe afspraak') %></td>
        </tr>
      <% }) %>
        <tr class="advies-total">
          <td colspan="5" class="right-label">Totaal uit te voeren werkzaamheden begroot €</td>
          <td><%- inp('achter.begroot', a.begroot, 'class="ink right" inputmode="decimal" data-advies-total') %></td>
          <td colspan="3"></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="panel panel-right">
    <div class="back-head"><span class="wo-title small-title">Uren</span></div>
    <table class="grid uren" data-uren>
      <colgroup><col class="c-dat"><col><col class="c-tijd2"><col class="c-tijd2"><col class="c-uren"><col class="c-tarief"><col class="c-bedrag"></colgroup>
      <thead><tr><th>Datum</th><th>Naam</th><th class="center">Van</th><th class="center">Tot</th><th class="center">Totaal uren</th><th class="center">Uurtarief</th><th class="center">Bedrag</th></tr></thead>
      <tbody>
      <% a.uren.forEach((u, i) => { %>
        <tr data-uur>
          <td><%- inp(`achter.uren.${i}.datum`, u.datum, 'placeholder=""') %></td>
          <td><%- inp(`achter.uren.${i}.naam`, u.naam) %></td>
          <td><%- inp(`achter.uren.${i}.van`, u.van, 'class="ink center" inputmode="numeric" data-van') %></td>
          <td><%- inp(`achter.uren.${i}.tot`, u.tot, 'class="ink center" inputmode="numeric" data-tot') %></td>
          <td><%- inp(`achter.uren.${i}.uren`, u.uren, 'class="ink center" inputmode="decimal" data-uren-n') %></td>
          <td><%- inp(`achter.uren.${i}.tarief`, u.tarief, 'class="ink right" inputmode="decimal" data-uren-tarief') %></td>
          <td><%- inp(`achter.uren.${i}.bedrag`, u.bedrag, 'class="ink right" inputmode="decimal" data-uren-bedrag') %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>

    <div class="back-blocks">
      <table class="grid kv banden-kv">
        <colgroup><col class="c-kvl"><col><col class="c-unit"></colgroup>
        <thead><tr><th colspan="3">Banden</th></tr></thead>
        <tbody>
          <tr><td class="rowlabel">Merk</td><td colspan="2"><%- inp('achter.band_merk', a.band_merk) %></td></tr>
          <tr><td class="rowlabel">Type</td><td colspan="2"><%- inp('achter.band_type', a.band_type) %></td></tr>
          <tr><td class="rowlabel">Maat</td><td colspan="2"><%- inp('achter.band_maat', a.band_maat) %></td></tr>
          <% for (const w of ['lv', 'la', 'rv', 'ra', 'reserve']) { %>
          <tr><td class="rowlabel"><%= WHEEL[w] %></td><td><%- inp(`achter.banden.${w}.profiel`, a.banden[w].profiel, 'class="ink center" inputmode="decimal" data-tread') %></td><td class="unit">mm</td></tr>
          <% } %>
        </tbody>
      </table>

      <table class="grid kv keuring-kv">
        <colgroup><col class="c-kvl2"><col><col class="c-kvl3"><col></colgroup>
        <thead><tr><th colspan="4">Keuringen – voertuiggegevens</th></tr></thead>
        <tbody>
          <tr><td colspan="4"><div class="labelled boxes"><%- check('[keuring][apk]', k.apk, 'APK') %><%- check('[keuring][goed]', k.goed, 'Goedkeuring') %><%- check('[keuring][af]', k.af, 'Afkeuring') %></div></td></tr>
          <tr><td colspan="4"><div class="labelled boxes"><%- check('[keuring][roet]', k.roet, 'Roetmeting') %><%- check('[keuring][viergas]', k.viergas, 'Viergastest') %></div></td></tr>
          <tr><td class="rowlabel">Plaats motorcode</td><td colspan="3"><%- inp('achter.keuring.motorcode', k.motorcode) %></td></tr>
          <tr><td class="rowlabel">Olietemperatuur min.</td><td><%- inp('achter.keuring.olie_min', k.olie_min, 'class="ink center"') %></td><td class="rowlabel">test</td><td><%- inp('achter.keuring.olie_test', k.olie_test, 'class="ink center"') %></td></tr>
          <tr><td class="rowlabel">Stationair toerental</td><td><%- inp('achter.keuring.stationair', k.stationair, 'class="ink center"') %></td><td class="rowlabel">tot</td><td><%- inp('achter.keuring.stationair_tot', k.stationair_tot, 'class="ink center"') %></td></tr>
          <tr><td class="rowlabel">Afregeltoerental</td><td><%- inp('achter.keuring.afregel', k.afregel, 'class="ink center"') %></td><td class="rowlabel">tot</td><td><%- inp('achter.keuring.afregel_tot', k.afregel_tot, 'class="ink center"') %></td></tr>
          <tr><td class="rowlabel">Max. K-waarde</td><td colspan="3"><%- inp('achter.keuring.k_waarde', k.k_waarde) %></td></tr>
        </tbody>
      </table>
    </div>

    <table class="grid kv leenauto-kv">
      <colgroup><col class="c-kvl"><col><col class="c-small"><col><col class="c-small"><col><col class="c-unit"></colgroup>
      <thead><tr><th colspan="7">Leenauto</th></tr></thead>
      <tbody>
        <tr><td class="rowlabel">Getankt</td><td colspan="6"><span class="janee janee-left">
          <label><input type="radio" name="d[achter][leenauto][getankt]" value="ja" <%= l.getankt === 'ja' ? 'checked' : '' %>><span>Ja</span></label>/<label><input type="radio" name="d[achter][leenauto][getankt]" value="nee" <%= l.getankt === 'nee' ? 'checked' : '' %>><span>Nee</span></label>
        </span></td></tr>
        <tr><td class="rowlabel">Merk/Type</td><td colspan="2"><%- inp('achter.leenauto.merk_type', l.merk_type) %></td><td class="rowlabel" colspan="1">Kenteken</td><td colspan="3"><%- inp('achter.leenauto.kenteken', l.kenteken, 'class="ink upper"') %></td></tr>
        <% for (const [key, lbl] of [['vertrek', 'Vertrek'], ['retour', 'Retour']]) { %>
        <tr><td class="rowlabel"><%= lbl %> km</td><td><%- inp(`achter.leenauto.${key}_km`, l[key + '_km'], 'class="ink center" inputmode="numeric"') %></td>
          <td class="rowlabel center">dd</td><td><%- inp(`achter.leenauto.${key}_dd`, l[key + '_dd'], 'class="ink center"') %></td>
          <td class="rowlabel center">om</td><td><%- inp(`achter.leenauto.${key}_om`, l[key + '_om'], 'class="ink center"') %></td><td class="unit">uur</td></tr>
        <% } %>
        <tr><td class="rowlabel">Huurtarief €</td><td><%- inp('achter.leenauto.tarief', l.tarief, 'class="ink right" inputmode="decimal"') %></td>
          <td colspan="5"><span class="janee janee-left"><span class="lbl-inline">ex. btw per</span>
            <label><input type="radio" name="d[achter][leenauto][per]" value="halve" <%= l.per === 'halve' ? 'checked' : '' %>><span>½ dag</span></label>/<label><input type="radio" name="d[achter][leenauto][per]" value="dag" <%= l.per === 'dag' ? 'checked' : '' %>><span>dag</span></label>
          </span></td></tr>
        <tr class="sign-row"><td class="rowlabel">Handtekening voor akkoord</td><td colspan="6"></td></tr>
      </tbody>
    </table>
  </div>
</section>
