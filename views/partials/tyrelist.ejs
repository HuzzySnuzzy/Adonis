<div class="table-wrap">
<table class="list clickable tyre-list">
  <thead><tr>
    <th class="ph-col"><span class="sr-only">Foto</span></th>
    <% if (showPlate) { %><th>Kenteken</th><th>Klant</th><% } %><th>Auto</th><th>Seizoen</th><th>Maat</th>
    <th>Profiel</th><th>Locatie</th><th>Label</th><th><%= showStatus ? 'Status' : 'Ingeslagen' %></th>
  </tr></thead>
  <tbody>
  <% for (const t of tyres) { %>
    <tr data-href="/bandenhotel/<%= t.id %>" class="<%= t.status === 'uitgegeven' ? 'is-out' : '' %>">
      <% const ph = locals.fotos && fotos.get(t.id); %>
      <td class="ph-col"><% if (ph) { %><a href="/fotos/<%= ph.id %>/full" data-photo-open class="ph-thumb" title="<%= ph.n %> foto<%= ph.n === 1 ? '' : "'s" %>"><img src="/fotos/<%= ph.id %>/thumb" alt="" loading="lazy"><% if (ph.n > 1) { %><span class="ph-n"><%= ph.n %></span><% } %></a><% } %></td>
      <% if (showPlate) { %>
      <td><% if (t.kenteken) { %><a href="/bandenhotel/<%= t.id %>"><%- include('/partials/plate', { kenteken: t.kenteken }) %></a><% } else { %><span class="muted small">geen kenteken</span><% } %></td>
      <td><% if (t.customer_id) { %><a href="/klant/<%= t.customer_id %>"><%= t.klant_naam || 'klant' %></a><% } else { %><%= t.klant_naam %><% } %></td>
      <% } %>
      <td><%= t.auto %></td>
      <td><% if (t.seizoen) { %><span class="season season-<%= /winter/i.test(t.seizoen) && !/zomer/i.test(t.seizoen) ? 'winter' : /zomer/i.test(t.seizoen) && !/winter/i.test(t.seizoen) ? 'zomer' : /all/i.test(t.seizoen) ? 'all' : 'mix' %>"><%- esc(t.seizoen).replace(/\//g, '/<wbr>') %></span><% } %></td>
      <td class="maat-col"><%= t.maat %></td>
      <td class="nowrap"><%- include('/partials/tread', { t }) %></td>
      <td><%= t.locatie %></td>
      <td><a class="tyre-label" href="/bandenhotel/<%= t.id %>"><%= t.label && t.label.length <= 12 ? t.label : t.label ? t.label.slice(0, 8) + '…' : '#' + t.id %></a><% if (!showPlate && t.soort === 'opslag') { %> <span class="out-pill" title="Staat in de overige bandenopslag">overige opslag</span><% } %></td>
      <td class="nowrap"><% if (showStatus && t.status === 'uitgegeven') { %><span class="out-pill">Uitgegeven <%= fmtDate(t.datum_uit) %></span><% } else if (showStatus && t.status === 'op_auto') { %><span class="car-pill">Op de auto</span><% } else { %><%= fmtDate(t.datum_in) %><% if (t.uitgenodigd_at) { %> <span class="called-pill" title="Gebeld op <%= fmtDate(t.uitgenodigd_at) %>">gebeld</span><% } %><% } %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
