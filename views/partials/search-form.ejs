<%# Zoekveld van het startscherm met links de keuze waarin gezocht wordt. Verwacht: q, scope (array) %>
<% const F0 = locals.feat || {}; const scopes = SEARCH_SCOPES.filter(([, , ok]) => ok(F0)); const sel = locals.scope || ['klanten']; %>
<form class="start-search" method="get" action="/zoeken" role="search" autocomplete="off" data-scope-form>
  <label for="startQ" class="sr-only">Zoeken</label>
  <div class="start-search-row">
    <% if (scopes.length > 1) { %>
    <fieldset class="search-scope" aria-label="Zoeken in">
      <legend class="sr-only">Zoeken in</legend>
      <% for (const [k, label] of scopes) { %>
      <label class="scope-chip"><input type="checkbox" name="in" value="<%= k %>" <%= sel.includes(k) ? 'checked' : '' %>><span><%= label %></span></label>
      <% } %>
    </fieldset>
    <% } %>
    <div class="start-search-field">
      <svg class="start-search-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
      <input id="startQ" type="search" name="q" value="<%= locals.q || '' %>" placeholder="Zoek op kenteken, naam, maat, onderdeel…" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" data-1p-ignore data-lpignore="true">
    </div>
    <button class="btn btn-primary btn-big" type="submit">Zoeken</button>
  </div>
</form>
