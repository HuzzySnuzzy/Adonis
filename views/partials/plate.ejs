<% const pi = plateInfo(kenteken); %><span class="plate plate-<%= pi.country === 'D' ? 'de' : pi.country === 'NL' ? 'nl' : 'other' %><%= pi.text.length > 8 ? ' plate-long' : '' %>" title="<%= pi.country === 'D' ? 'Duits kenteken' : pi.country === 'NL' ? 'Nederlands kenteken' : 'Kenteken' %>"><% if (pi.country) { %><span class="plate-eu" aria-hidden="true"><%- PLATE_STARS %><b><%= pi.country %></b></span><% } %><span class="plate-txt"><% if (pi.country === 'D') { %><span><%= pi.parts[0] %></span><span class="plate-seals" aria-hidden="true"><i></i><i></i></span><span class="sr-only">-</span><span><%= pi.parts[1] %>&nbsp;<%= pi.parts[2] %></span><% } else { %><%= pi.text %><% } %></span></span>
