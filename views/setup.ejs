<%- include('/partials/head') %>
<main class="auth-card">
  <div class="auth-logo"><%- include('/partials/logo', { big: true }) %></div>
  <h1 class="center">Welkom bij ADONIS</h1>
  <p class="muted">Er zijn nog geen accounts. Maak het eerste account aan: dit wordt de <strong>ADONIS-beheerder</strong>
    (eigenaar). Die kan andere gebruikers toevoegen en de systeeminstellingen beheren, zoals online bereikbaarheid via Cloudflare.</p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/setup">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Naam (verschijnt als monteur)
      <input name="name" value="<%= values.name || '' %>" required>
    </label>
    <label>Gebruikersnaam
      <input name="username" value="<%= values.username || '' %>" autocomplete="username" autocapitalize="none" required>
    </label>
    <label>Wachtwoord (minimaal 8 tekens)
      <input name="password" type="password" autocomplete="new-password" minlength="8" required>
    </label>
    <label>Herhaal wachtwoord
      <input name="password2" type="password" autocomplete="new-password" minlength="8" required>
    </label>
    <button class="btn btn-primary btn-block" type="submit">Account aanmaken</button>
  </form>
</main>
<%- include('/partials/foot') %>
