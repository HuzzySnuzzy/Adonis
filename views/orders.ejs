<%- include('/partials/head') %>
<main class="page">
  <div class="page-head">
    <h1>Alle werkopdrachten</h1>
    <form class="search" method="get" action="/werkopdrachten" role="search">
      <input type="search" name="q" value="<%= q %>" placeholder="Zoek op nummer, kenteken, onderdeel, foutcode, tekst…" autofocus>
      <button class="btn" type="submit">Zoeken</button>
      <% if (q) { %><a class="btn btn-ghost" href="/werkopdrachten">Wissen</a><% } %>
    </form>
  </div>
  <% if (orders.length === 0) { %>
    <div class="empty"><p><%= q ? 'Niets gevonden voor “' + q + '”.' : 'Nog geen werkopdrachten.' %></p></div>
  <% } else { %>
    <p class="muted"><%= q ? orders.length + ' gevonden' : 'Laatste ' + orders.length + ' werkopdrachten' %></p>
    <%- include('/partials/orderlist', { orders, showPlate: true }) %>
  <% } %>
</main>
<script src="/static/js/common.js"></script>
<%- include('/partials/foot') %>
