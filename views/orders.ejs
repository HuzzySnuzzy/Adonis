<%- include('/partials/head') %>
<main class="page wide">
  <div class="page-head">
    <h1><%= status === 'klaar' ? 'Facturatie – klaar om te factureren' : 'Alle werkopdrachten' %></h1>
    <form class="search" method="get" action="/werkopdrachten" role="search" autocomplete="off">
      <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
      <input type="search" name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" data-1p-ignore data-lpignore="true" value="<%= q %>" placeholder="Zoek op nummer, kenteken, onderdeel, foutcode, tekst…" data-autofocus>
      <button class="btn" type="submit">Zoeken</button>
      <% if (q) { %><a class="btn btn-ghost" href="/werkopdrachten">Wissen</a><% } %>
    </form>
    <div class="head-buttons">
      <a class="btn btn-ghost" href="/zoekwoorden" title="Woorden die hetzelfde betekenen (bijv. lampen = verlichting)">Zoekwoorden</a>
      <% if (user.is_admin && aiConfigured && feat.ai) { %>
      <button class="btn" type="button" data-ai-task="alle" data-ai-action="/aandachtspunten/alles" data-ai-bulk
        data-ai-title="Aandachtspunten voor alle klanten"><%- include('/partials/ai-icon') %> Aandachtspunten voor alle klanten</button>
      <% } %>
    </div>
  </div>
  <div class="ai-job" data-ai-job hidden></div>
  <% const qs = (st) => '/werkopdrachten' + ((st || q) ? '?' + [st ? 'status=' + st : '', q ? 'q=' + encodeURIComponent(q) : ''].filter(Boolean).join('&') : ''); %>
  <div id="live-orders" data-live>
  <%- include("/partials/search-hint") %>
  <nav class="status-tabs" aria-label="Filter op status">
    <a href="<%= qs('') %>" class="<%= !status ? 'active' : '' %>">Alle</a>
    <% for (const [k, label] of Object.entries(STATUSES)) { %>
      <a href="<%= qs(k) %>" class="<%= status === k ? 'active' : '' %>"><%= label %><span class="count"><%= counts[k] %></span></a>
    <% } %>
  </nav>
  <% if (orders.length === 0) { %>
    <div class="empty"><p><%= q ? 'Niets gevonden voor “' + q + '”.' : status === 'klaar' ? 'Er ligt niets klaar om te factureren. 🎉' : status ? 'Geen werkopdrachten met deze status.' : 'Nog geen werkopdrachten.' %></p></div>
  <% } else { %>
    <p class="muted"><%= q || status ? orders.length + ' gevonden' + (status === 'klaar' ? ' – oudste bovenaan' : '') : 'Laatste ' + orders.length + ' werkopdrachten' %></p>
    <%- include('/partials/orderlist', { orders, showPlate: true }) %>
  <% } %>
  </div>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<script src="/static/js/ai.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
