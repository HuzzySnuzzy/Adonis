<%- include('/partials/head') %>
<%
  const W = weergave;
  const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
  const dayUrl = (d) => '/werkopdrachten' + (d === today ? '' : '?dag=' + d);
  const qs = (st) => '/werkopdrachten?' + [st ? 'status=' + st : 'weergave=lijst', q ? 'q=' + encodeURIComponent(q) : ''].filter(Boolean).join('&');
  const WD = ['ma', 'di', 'wo', 'do', 'vr', 'za', 'zo'];
%>
<main class="page wide">
  <div class="page-head">
    <h1><%= status === 'klaar' ? 'Klaar voor facturatie' : 'Werkopdrachten' %></h1>
    <form class="search" method="get" action="/werkopdrachten" role="search" autocomplete="off">
      <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
      <input type="search" name="q" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" data-1p-ignore data-lpignore="true" value="<%= q %>" placeholder="Zoek op nummer, kenteken, onderdeel, foutcode, tekst…" <%= W === 'lijst' ? 'data-autofocus' : '' %>>
      <button class="btn" type="submit">Zoeken</button>
      <% if (q) { %><a class="btn btn-ghost" href="/werkopdrachten?weergave=lijst">Wissen</a><% } %>
    </form>
    <div class="head-buttons">
      <% if (user.is_admin && aiConfigured && feat.ai && W === 'lijst') { %>
      <button class="btn" type="button" data-ai-task="alle" data-ai-action="/aandachtspunten/alles" data-ai-bulk
        data-ai-title="Aandachtspunten voor alle klanten"><%- include('/partials/ai-icon') %> Aandachtspunten voor alle klanten</button>
      <% } %>
    </div>
  </div>
  <div class="ai-job" data-ai-job hidden></div>

  <nav class="ord-views" aria-label="Weergave">
    <a href="<%= dayUrl(dag) %>" class="<%= ['dag', 'achterstand', 'toekomst'].includes(W) ? 'active' : '' %>">Dag</a>
    <a href="/werkopdrachten?weergave=kalender&dag=<%= dag %>" class="<%= W === 'kalender' ? 'active' : '' %>">Kalender</a>
    <a href="/werkopdrachten?weergave=lijst" class="<%= W === 'lijst' ? 'active' : '' %>">Lijst</a>
  </nav>

  <div id="live-orders" data-live>
  <% if (W === 'dag') { %>
    <div class="day-nav">
      <a class="btn day-arrow" href="<%= dayUrl(nav.prev) %>" data-day-prev aria-label="Vorige dag" title="Vorige dag (←)">‹</a>
      <% if (nav.achterstand) { %><a class="day-pill day-pill-warn" href="/werkopdrachten?weergave=achterstand&dag=<%= dag %>" title="<%= nav.achterstand %> werkopdracht<%= nav.achterstand === 1 ? '' : 'en' %> van eerder nog niet klaar"><%= nav.achterstand %> open</a><% } else { %><span></span><% } %>
      <div class="day-title">
        <label class="day-date" title="Andere datum kiezen">
          <h2><span class="day-long"><%= cap(dagLabel) %></span><span class="day-short"><%= cap(locals.dagShort || dagLabel) %></span></h2>
          <input type="date" value="<%= dag %>" data-day-jump aria-label="Ga naar datum">
        </label>
        <% if (dag === today) { %><span class="day-today">Vandaag</span><% } else { %><a class="day-today day-today-link" href="/werkopdrachten">Naar vandaag</a><% } %>
      </div>
      <% if (nav.toekomst) { %><a class="day-pill" href="/werkopdrachten?weergave=toekomst&dag=<%= dag %>" title="<%= nav.toekomst %> afspra<%= nav.toekomst === 1 ? 'ak' : 'ken' %> na deze dag"><%= nav.toekomst %> later</a><% } else { %><span></span><% } %>
      <a class="btn day-arrow" href="<%= dayUrl(nav.next) %>" data-day-next aria-label="Volgende dag" title="Volgende dag (→)">›</a>
    </div>

    <% if (!orders.length) { %>
      <div class="empty day-empty"><p>Geen werkopdrachten op deze dag.</p>
        <a class="btn btn-primary" href="/werkopdracht/nieuw?datum=<%= dag %>">+ Werkopdracht op <%= dag === today ? 'vandaag' : 'deze dag' %></a></div>
    <% } else { %>
      <section class="day-sec" aria-label="Open">
        <h3 class="day-h">Open <span class="count"><%= open.length %></span></h3>
        <% if (open.length) { %><%- include('/partials/orderlist', { orders: open, showPlate: true, groupByDate: false }) %>
        <% } else { %><p class="muted small"><%= wacht.length ? 'Geen open werk; de rest wacht op onderdelen of is klaar.' : 'Alles van deze dag is klaar.' %></p><% } %>
      </section>
      <% if (wacht.length) { %>
      <section class="day-sec day-wait" aria-label="Wacht op onderdelen">
        <h3 class="day-h">Wacht op onderdelen <span class="count"><%= wacht.length %></span></h3>
        <%- include('/partials/orderlist', { orders: wacht, showPlate: true, groupByDate: false }) %>
      </section>
      <% } %>
      <% if (done.length) { %>
      <section class="day-sec day-done" aria-label="Klaar">
        <h3 class="day-h">Klaar <span class="count"><%= done.length %></span></h3>
        <%- include('/partials/orderlist', { orders: done, showPlate: true, groupByDate: false }) %>
      </section>
      <% } %>
      <p class="day-add"><a class="btn" href="/werkopdracht/nieuw?datum=<%= dag %>">+ Werkopdracht op <%= dag === today ? 'vandaag' : 'deze dag' %></a></p>
    <% } %>

  <% } else if (W === 'achterstand' || W === 'toekomst') { %>
    <div class="day-listhead">
      <a class="btn btn-small" href="<%= dayUrl(dag) %>">‹ Terug naar <%= dag === today ? 'vandaag' : dagLabel %></a>
      <h2><%= W === 'achterstand' ? `Nog open van vóór ${dagLabel}` : `Afspraken na ${dagLabel}` %></h2>
    </div>
    <% if (!orders.length) { %><div class="empty"><p><%= W === 'achterstand' ? 'Alles van eerder is klaar.' : 'Geen afspraken na deze dag.' %></p></div>
    <% } else { %>
      <p class="muted"><%= orders.length %> werkopdracht<%= orders.length === 1 ? '' : 'en' %><%= W === 'achterstand' ? ', oudste bovenaan' : ', eerstvolgende bovenaan' %></p>
      <%- include('/partials/orderlist', { orders, showPlate: true, groupByDate: true }) %>
    <% } %>
    <% if (W === 'achterstand' && wacht.length) { %>
      <h3 class="day-h day-wait-h">Wacht op onderdelen <span class="count"><%= wacht.length %></span></h3>
      <p class="muted small">Ook nog niet klaar, maar hier kan nu niet aan worden gewerkt (telt niet mee in het aantal open).</p>
      <%- include('/partials/orderlist', { orders: wacht, showPlate: true, groupByDate: true }) %>
    <% } %>

  <% } else if (W === 'kalender') { %>
    <div class="cal-nav">
      <a class="btn" href="/werkopdrachten?weergave=kalender&maand=<%= prevMaand %>" aria-label="Vorige maand">‹</a>
      <h2><%= cap(maandLabel) %></h2>
      <a class="btn" href="/werkopdrachten?weergave=kalender&maand=<%= nextMaand %>" aria-label="Volgende maand">›</a>
      <% if (maand !== today.slice(0, 7)) { %><a class="btn btn-ghost" href="/werkopdrachten?weergave=kalender">Deze maand</a><% } %>
      <span class="cal-legend muted small"><span class="cal-chip is-open">open</span> <span class="cal-chip is-wait">wacht</span> <span class="cal-chip">klaar</span></span>
    </div>
    <div class="cal-grid" role="grid" aria-label="<%= maandLabel %>">
      <% for (const w of WD) { %><div class="cal-wd" role="columnheader"><%= w %></div><% } %>
      <% for (const week of weeks) { for (const x of week) { const other = !x.d.startsWith(maand); const late = x.open && x.d < today; %>
        <a class="cal-day<%= other ? ' is-other' : '' %><%= x.d === today ? ' is-today' : '' %><%= late ? ' is-late' : '' %><%= x.d === dag && x.d !== today ? ' is-sel' : '' %>" href="<%= dayUrl(x.d) %>" role="gridcell"
           aria-label="<%= x.d.split('-').reverse().join('-') %>: <%= x.open %> open, <%= x.wacht %> wacht, <%= x.done %> klaar">
          <span class="cal-num"><%= Number(x.d.slice(8)) %></span>
          <% const parts = [x.open && `<b>${x.open}</b> open`, x.wacht && `${x.wacht} wacht`, x.done && `${x.done} klaar`].filter(Boolean); %>
          <% if (parts.length) { %><span class="cal-count"><%- parts.join(' · ') %></span><% } %>
          <% for (const it of x.items) { %><span class="cal-chip<%= it.open ? ' is-open' : it.wacht ? ' is-wait' : '' %><%= it.kenteken ? '' : ' no-plate' %>"><%= it.tijd ? it.tijd + ' ' : '' %><%= it.kenteken || 'Geen kenteken' %></span><% } %>
          <% const tot = x.open + x.wacht + x.done; if (tot > x.items.length) { %><span class="cal-more muted small">+<%= tot - x.items.length %> meer</span><% } %>
        </a>
      <% } } %>
    </div>

  <% } else { %>
    <%- include("/partials/search-hint") %>
    <nav class="status-tabs" aria-label="Filter op status">
      <a href="<%= qs('') %>" class="<%= !status ? 'active' : '' %>">Alle</a>
      <% for (const [k, label] of Object.entries(STATUSES)) { %>
        <a href="<%= qs(k) %>" class="<%= status === k ? 'active' : '' %>"><%= label %><span class="count"><%= counts[k] %></span></a>
      <% } %>
    </nav>
    <% if (orders.length === 0) { %>
      <div class="empty"><p><%= q ? 'Niets gevonden voor “' + q + '”.' : status === 'klaar' ? 'Er ligt niets klaar om te factureren.' : status ? 'Geen werkopdrachten met deze status.' : 'Nog geen werkopdrachten.' %></p></div>
    <% } else { %>
      <p class="muted"><%= q || status ? orders.length + ' gevonden' + (status === 'klaar' ? ' – oudste bovenaan' : '') : 'Laatste ' + orders.length + ' werkopdrachten' %></p>
      <%- include('/partials/orderlist', { orders, showPlate: true, groupByDate: status !== 'klaar' }) %>
    <% } %>
  <% } %>
  </div>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<script src="/static/js/ai.js?v=<%= assetVersion %>"></script>
<script src="/static/js/orders-day.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
