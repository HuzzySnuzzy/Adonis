<%- include('/partials/head') %>
<main class="page">
  <div class="page-head">
    <h1><%= status === 'klaar' ? 'Facturatie – klaar om te factureren' : 'Alle werkopdrachten' %></h1>
    <form class="search" method="get" action="/werkopdrachten" role="search">
      <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
      <input type="search" name="q" value="<%= q %>" placeholder="Zoek op nummer, kenteken, onderdeel, foutcode, tekst…" autofocus>
      <button class="btn" type="submit">Zoeken</button>
      <% if (q) { %><a class="btn btn-ghost" href="/werkopdrachten">Wissen</a><% } %>
    </form>
  </div>
  <% const qs = (st) => '/werkopdrachten' + ((st || q) ? '?' + [st ? 'status=' + st : '', q ? 'q=' + encodeURIComponent(q) : ''].filter(Boolean).join('&') : ''); %>
  <div id="live-orders" data-live>
  <nav class="status-tabs" aria-label="Filter op status">
    <a href="<%= qs('') %>" class="<%= !status ? 'active' : '' %>">Alle</a>
    <% for (const [k, label] of Object.entries(STATUSES)) { %>
      <a href="<%= qs(k) %>" class="<%= status === k ? 'active' : '' %>"><%= label %><span class="count"><%= counts[k] %></span></a>
    <% } %>
  </nav>
  <% if (orders.length === 0) { %>
    <div class="empty"><p><%= q ? 'Niets gevonden voor “' + q + '”.' : status === 'klaar' ? 'Er ligt niets klaar om te factureren. 🎉' : status ? 'Geen werkopdrachten met deze status.' : 'Nog geen werkopdrachten.' %></p></div>
  <% } else { %>
    <p class="muted"><%= q || status ? orders.length + ' gevonden' + (status === 'klaar' ? ' – oudste bovenaan' : '') : 'Laatste ' + orders.length + ' werkopdrachten' %></p>
    <%- include('/partials/orderlist', { orders, showPlate: true }) %>
  <% } %>
  </div>
</main>
<script src="/static/js/common.js"></script>
<%- include('/partials/foot') %>
