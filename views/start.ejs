<%- include('/partials/head') %>
<%
  // Vandaag: wat er te doen is, met een groot getal (zodat je het in één oogopslag ziet).
  const todo = [];
  todo.push({ href: '/bandenhotel/wissellijst', icon: 'swap', hue: 'amber', n: swaps, label: swaps === 1 ? 'klant bellen' : 'klanten bellen', sub: 'voor ' + (swapTarget === 'winter' ? 'winter' : 'zomer') + 'banden' });
  todo.push({ href: '/apk', icon: 'calendar', hue: 'green', n: apkSoon, label: apkSoon === 1 ? 'klant bellen' : 'klanten bellen', sub: 'voor de APK' });
  if (user.can_invoice) todo.push({ href: '/werkopdrachten?status=klaar', icon: 'euro', hue: 'violet', n: counts.klaar, label: counts.klaar === 1 ? 'werkopdracht' : 'werkopdrachten', sub: 'klaar om te factureren' });
  // Snel naar: één regel per onderdeel, elk met een eigen kleur.
  const tiles = [
    { href: '/', icon: 'people', hue: 'blue', title: 'Klanten', text: 'Op kenteken of naam' },
    { href: '/werkopdrachten', icon: 'list', hue: 'slate', title: 'Werkopdrachten', text: 'Alle werkopdrachten' },
    { href: '/bandenhotel', icon: 'tyre', hue: 'amber', title: 'Bandenhotel', text: 'Banden in opslag' },
    { href: '/voorraad', icon: 'box', hue: 'teal', title: 'Voorraad', text: 'Onderdelen en banden' },
    { href: '/portaal', icon: 'grid', hue: 'violet', title: 'Portaal', text: 'Websites en leveranciers' },
  ];
  if (importOn) tiles.push({ href: '/importeren', icon: 'camera', hue: 'rose', title: 'Foto importeren', text: 'Papier overnemen' });
  tiles.push({ href: '/ai-analyse', icon: 'ai', hue: 'rose', title: 'AI-analyse', text: 'Röntgenfoto van een auto' });
  tiles.push({ href: '/hulp', icon: 'help', hue: 'slate', title: 'Hulp', text: 'Uitleg in stappen' });
  const ICONS = {
    ai: '<path d="M9 2.5v3M15 2.5v3M9 18.5v3M15 18.5v3M2.5 9h3M2.5 15h3M18.5 9h3M18.5 15h3"/><rect x="5.5" y="5.5" width="13" height="13" rx="3"/><path d="M8.6 15.2 10.4 9h.4l1.8 6.2M9.2 13.4h2.6M15 9v6.2"/>',
    plus: '<path d="M12 5v14M5 12h14"/>',
    people: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.6c2.6.2 4.6 1.9 5.3 4.9"/>',
    list: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
    euro: '<path d="M17 6.5A6.5 6.5 0 1 0 17 17.5M5 10.5h9M5 13.5h9"/>',
    tyre: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.5"/><path d="M12 3.5v5M12 15.5v5M3.5 12h5M15.5 12h5"/>',
    swap: '<path d="M7 7h11l-3-3M17 17H6l3 3"/>',
    calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4M8 14.5l2.5 2.5 5-5"/>',
    box: '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
    camera: '<path d="M4 8h3l2-2.5h6L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>',
    grid: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
    help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.6 2.6 0 0 1 5 1c0 1.8-2.5 2.2-2.5 4"/><circle cx="12" cy="17.5" r=".6" fill="currentColor"/>',
  };
%>
<main class="page start-page">
  <header class="start-hero">
    <p class="start-date"><%= today %></p>
    <h1><%= greeting %>, <%= user.name.split(' ')[0] %></h1>

    <form class="start-search" method="get" action="/" role="search" autocomplete="off">
      <label for="startQ" class="sr-only">Klant zoeken</label>
      <div class="start-search-row">
        <svg class="start-search-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
        <input id="startQ" type="search" name="q" placeholder="Zoek een klant: kenteken of naam" autocomplete="off" autocorrect="off" autocapitalize="characters" spellcheck="false" enterkeyhint="search" data-1p-ignore data-lpignore="true">
        <button class="btn btn-primary btn-big" type="submit">Zoeken</button>
      </div>
    </form>
    <%# Terwijl u typt verschijnen hier de klanten die passen (uit de klantenlijst). %>
    <div id="live-customers" class="start-results" data-live data-live-remote></div>
  </header>

  <a class="start-new" href="/werkopdracht/nieuw">
    <span class="start-new-icon"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
    <span class="start-new-text"><b>Nieuwe werkopdracht</b><span>Een nieuwe klus invullen</span></span>
    <svg class="start-new-arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>

  <h2 class="start-label">Vandaag</h2>
  <nav class="start-stats" aria-label="Vandaag te doen">
    <% for (const t of todo) { %>
    <a class="start-stat hue-<%= t.hue %><%= t.n ? '' : ' is-zero' %>" href="<%= t.href %>">
      <span class="start-stat-icon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><%- ICONS[t.icon] %></svg></span>
      <span class="start-stat-n"><%= t.n %></span>
      <span class="start-stat-label"><%= t.label %> <br><span class="muted"><%= t.sub %></span></span>
    </a>
    <% } %>
  </nav>

  <h2 class="start-label">Snel naar</h2>
  <nav class="start-tiles" aria-label="Onderdelen">
    <% for (const t of tiles) { %>
    <a class="start-tile hue-<%= t.hue %>" href="<%= t.href %>">
      <span class="start-tile-icon"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><%- ICONS[t.icon] %></svg></span>
      <span class="start-tile-title"><%= t.title %></span>
      <span class="start-tile-text"><%= t.text %></span>
    </a>
    <% } %>
  </nav>

  <% if (recent.length) { %>
  <section class="start-recent">
    <h2 class="start-label">Laatst bijgewerkt</h2>
    <%- include('/partials/orderlist', { orders: recent, showPlate: true }) %>
  </section>
  <% } %>
</main>
<script src="/static/js/common.js?v=<%= assetVersion %>"></script>
<%- include('/partials/foot') %>
