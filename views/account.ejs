<%- include('/partials/head') %>
<main class="page narrow">
  <h1>Mijn account</h1>
  <p class="muted">Ingelogd als <strong><%= user.username %></strong> (<%= user.name %>)<%= user.is_admin ? ' · beheerder' : '' %>.</p>
  <section class="card">
    <h2>Wachtwoord wijzigen</h2>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="post" action="/account/wachtwoord" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Huidig wachtwoord <input type="password" name="current" autocomplete="current-password" required></label>
      <label>Nieuw wachtwoord (minimaal 8 tekens) <input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
      <label>Herhaal nieuw wachtwoord <input type="password" name="password2" autocomplete="new-password" minlength="8" required></label>
      <button class="btn btn-primary" type="submit">Wachtwoord wijzigen</button>
    </form>
  </section>
</main>
<%- include('/partials/foot') %>
